{% if pictogram %}
{% set svg_path = '@pictograms/' ~ pictogram ~ '.svg' %}
<div class="pictogram pictogram--size-{{ (size in [48, 64, 80, 96, 128]) ? size : 48 }}" style="fill: {{ color|default('var(--icon-primary, currentColor)') }};">
    {{ source(svg_path, ignore_missing = true) }}
</div>
{% endif %}
