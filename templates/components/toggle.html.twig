{% set items = items|default([]) %}
{% set name = name|default('toggle') %}
{% set inline = inline|default(false) %}
{% set reverse = reverse|default(false) %}
{% set native = native|default(false) %}
{% set base_id = id_prefix|default(name|replace({'[': '-', ']': '', ' ': '-', '.': '-'})) %}

{% for item in items %}
    {% set item_label = item.label|default('') %}
    {% set item_value = item.value|default(loop.index0) %}
    {% set item_id = item.id|default(base_id ~ '-' ~ loop.index0 ~ '-' ~ item_value|replace({' ': '-', '.': '-', '_': '-', '[': '-', ']': ''})|lower) %}
    {% set item_name = item.name|default(name) %}
    {% set classes = ['form-check', 'form-switch'] %}

    {% if inline %}
        {% set classes = classes|merge(['form-check-inline']) %}
    {% endif %}

    {% if reverse %}
        {% set classes = classes|merge(['form-check-reverse']) %}
    {% endif %}

    <div class="{{ classes|join(' ') }}">
        <input
            class="form-check-input"
            type="checkbox"
            name="{{ item_name }}"
            id="{{ item_id }}"
            value="{{ item_value }}"
            role="switch"
            {% if native %}switch{% endif %}
            {% if item.checked|default(false) %}checked{% endif %}
            {% if item.disabled|default(false) %}disabled{% endif %}
        >
        <label class="form-check-label" for="{{ item_id }}">
            {{ item_label|trans }}
        </label>
    </div>
{% endfor %}
