<!-- 
backgroundToken (layer/background) -> default layer
label (string) -> aria-label on root menu
menuAlignment (start/end) -> dropdown-menu-start / dropdown-menu-end (default start)
open (true/false) -> default false
size (xs/sm/md/lg)
className (optional)
attributes (optional key/value)
items (array of items) { 
    menuItem {
        label
        renderIcon (icon class)
        href -> if defined, render <a href>; else <button type="button">
        shortcut (string)
        kind (danger/default)
        disabled (true/false)
        attributes (optional key/value on control)
        submenu (optional array) { menuItem, menuItemRadioGroup, menuItemDivider, menuItemGroup }
    },
    menuItemRadioGroup {
        label
        items (array of menuItem objects; <a> or <button> per item)
        defaultSelectedItem (value matching option value/label)
    },
    menuItemDivider,
    menuItemGroup {
        label
        items (array of menuItemSelectable objects; <a> or <button> per item)
    }
}
-->

{% set size_class_map = {
    'xs': 'menu--xs',
    'sm': 'menu--sm',
    'md': 'menu--md',
    'lg': 'menu--lg'
} %}

{% macro control_attributes(attrs) %}
{% if attrs is defined and attrs is not empty %}{% for name, value in attrs %} {{ name }}="{{ value }}"{% endfor %}{% endif %}
{% endmacro %}

{% macro menu_rows(items, size) %}
{% import _self as m %}
{% for row in items %}
    {% if row.menuItem is defined %}
        {% set mi = row.menuItem %}
        {% set item_class = 'menu-item dropdown-item' ~ (mi.disabled|default(false) ? ' menu-item--disabled' : '') ~ ((mi.kind|default('default')) == 'danger' ? ' menu-item--danger' : '') %}
        {% if mi.submenu is defined and mi.submenu|length > 0 %}
            <li role="none">
                <button type="button" role="menuitem" class="{{ item_class }}" tabindex="0"
                    aria-haspopup="true" aria-expanded="false"
                    {% if mi.disabled|default(false) %}disabled aria-disabled="true"{% endif %}
                    {{ m.control_attributes(mi.attributes|default({})) }}>
                    <div class="menu-item__selection-icon"></div>
                    <div class="menu-item__icon">{% if mi.renderIcon is defined and mi.renderIcon %}<i class="{{ mi.renderIcon }}"></i>{% endif %}</div>
                    <div class="menu-item__label" dir="ltr">{{ mi.label|trans }}</div>
                    {% if mi.kind|default('default') == 'danger' %}
                        <span class="visually-hidden">{{ 'mautic.marketplace.menu.danger_hint'|trans }}</span>
                    {% endif %}
                    <div class="menu-item__shortcut"><i class="ri-arrow-right-s-line"></i></div>
                </button>
                <ul tabindex="0" class="dropdown-menu menu menu--{{ size }}" role="menu" aria-label="{{ mi.label|trans }}">
                    {{ m.menu_rows(mi.submenu, size) }}
                </ul>
            </li>
        {% elseif mi.href is defined and mi.href %}
            <li role="none">
                <a href="{{ mi.href }}" role="menuitem" class="{{ item_class }}"
                    {% if mi.disabled|default(false) %}aria-disabled="true" tabindex="-1"{% else %}tabindex="0"{% endif %}
                    {{ m.control_attributes(mi.attributes|default({})) }}>
                    <div class="menu-item__selection-icon"></div>
                    <div class="menu-item__icon">{% if mi.renderIcon is defined and mi.renderIcon %}<i class="{{ mi.renderIcon }}"></i>{% endif %}</div>
                    <div class="menu-item__label" dir="ltr">{{ mi.label|trans }}</div>
                    {% if mi.kind|default('default') == 'danger' %}
                        <span class="visually-hidden">{{ 'mautic.marketplace.menu.danger_hint'|trans }}</span>
                    {% endif %}
                    <div class="menu-item__shortcut">{% if mi.shortcut is defined and mi.shortcut %}{{ mi.shortcut|trans }}{% endif %}</div>
                </a>
            </li>
        {% else %}
            <li role="none">
                <button type="button" role="menuitem" class="{{ item_class }}"
                    tabindex="{% if mi.disabled|default(false) %}-1{% else %}0{% endif %}"
                    {% if mi.disabled|default(false) %}disabled aria-disabled="true"{% endif %}
                    {{ m.control_attributes(mi.attributes|default({})) }}>
                    <div class="menu-item__selection-icon"></div>
                    <div class="menu-item__icon">{% if mi.renderIcon is defined and mi.renderIcon %}<i class="{{ mi.renderIcon }}"></i>{% endif %}</div>
                    <div class="menu-item__label" dir="ltr">{{ mi.label|trans }}</div>
                    {% if mi.kind|default('default') == 'danger' %}
                        <span class="visually-hidden">{{ 'mautic.marketplace.menu.danger_hint'|trans }}</span>
                    {% endif %}
                    <div class="menu-item__shortcut">{% if mi.shortcut is defined and mi.shortcut %}{{ mi.shortcut|trans }}{% endif %}</div>
                </button>
            </li>
        {% endif %}
    {% elseif row.menuItemDivider is defined %}
        <li class="menu-item-divider" role="separator"></li>
    {% elseif row.menuItemRadioGroup is defined %}
        {% set rg = row.menuItemRadioGroup %}
        {% set rg_items = rg.items is defined ? rg.items : rg.options|default([]) %}
        <li class="menu-item-radio-group" role="none">
            <ul role="group" aria-label="{{ rg.label|trans }}">
                {% for raw in rg_items %}
                    {% set opt = raw.menuItem|default(raw) %}
                    {% set opt_val = opt.value|default(opt.label) %}
                    {% set is_checked = rg.defaultSelectedItem is defined and rg.defaultSelectedItem == opt_val %}
                    {% set opt_class = 'menu-item' %}
                    {% if opt.href is defined and opt.href %}
                        <li role="none">
                            <a href="{{ opt.href }}" role="menuitemradio" class="{{ opt_class }}" aria-checked="{{ is_checked ? 'true' : 'false' }}" tabindex="0" {{ m.control_attributes(opt.attributes|default({})) }}>
                                <div class="menu-item__selection-icon">{% if is_checked %}<i class="ri-check-line"></i>{% endif %}</div>
                                <div class="menu-item__icon">{% if opt.renderIcon is defined and opt.renderIcon %}<i class="{{ opt.renderIcon }}"></i>{% endif %}</div>
                                <div class="menu-item__label" dir="ltr">{{ opt.label|trans }}</div>
                            </a>
                        </li>
                    {% else %}
                        <li role="none">
                            <button type="button" role="menuitemradio" class="{{ opt_class }}" aria-checked="{{ is_checked ? 'true' : 'false' }}" tabindex="0"
                                {% if opt.disabled|default(false) %}disabled aria-disabled="true"{% endif %}
                                {{ m.control_attributes(opt.attributes|default({})) }}>
                                <div class="menu-item__selection-icon">{% if is_checked %}<i class="ri-check-line"></i>{% endif %}</div>
                                <div class="menu-item__icon">{% if opt.renderIcon is defined and opt.renderIcon %}<i class="{{ opt.renderIcon }}"></i>{% endif %}</div>
                                <div class="menu-item__label" dir="ltr">{{ opt.label|trans }}</div>
                            </button>
                        </li>
                    {% endif %}
                {% endfor %}
            </ul>
        </li>
    {% elseif row.menuItemGroup is defined %}
        {% set g = row.menuItemGroup %}
        <li class="menu-item-group" role="none">
            <ul role="group" aria-label="{{ g.label|trans }}">
                {% for raw in g.items %}
                    {% set opt = raw.menuItemSelectable|default(raw) %}
                    {% set is_on = opt.defaultSelected|default(false) %}
                    {% set opt_class = 'menu-item' ~ (is_on ? ' menu-item-selectable--selected' : '') %}
                    {% if opt.href is defined and opt.href %}
                        <li role="none">
                            <a href="{{ opt.href }}" role="menuitemcheckbox" class="{{ opt_class }}" aria-checked="{{ is_on ? 'true' : 'false' }}" tabindex="0" {{ m.control_attributes(opt.attributes|default({})) }}>
                                <div class="menu-item__selection-icon">{% if is_on %}<i class="ri-check-line"></i>{% endif %}</div>
                                <div class="menu-item__icon">{% if opt.renderIcon is defined and opt.renderIcon %}<i class="{{ opt.renderIcon }}"></i>{% endif %}</div>
                                <div class="menu-item__label" dir="ltr">{{ opt.label|trans }}</div>
                                <div class="menu-item__shortcut">{% if opt.shortcut is defined and opt.shortcut %}{{ opt.shortcut|trans }}{% endif %}</div>
                            </a>
                        </li>
                    {% else %}
                        <li role="none">
                            <button type="button" role="menuitemcheckbox" class="{{ opt_class }}" aria-checked="{{ is_on ? 'true' : 'false' }}" tabindex="0"
                                {% if opt.disabled|default(false) %}disabled aria-disabled="true"{% endif %}
                                {{ m.control_attributes(opt.attributes|default({})) }}>
                                <div class="menu-item__selection-icon">{% if is_on %}<i class="ri-check-line"></i>{% endif %}</div>
                                <div class="menu-item__icon">{% if opt.renderIcon is defined and opt.renderIcon %}<i class="{{ opt.renderIcon }}"></i>{% endif %}</div>
                                <div class="menu-item__label" dir="ltr">{{ opt.label|trans }}</div>
                                <div class="menu-item__shortcut">{% if opt.shortcut is defined and opt.shortcut %}{{ opt.shortcut|trans }}{% endif %}</div>
                            </button>
                        </li>
                    {% endif %}
                {% endfor %}
            </ul>
        </li>
    {% endif %}
{% endfor %}
{% endmacro %}

{% import _self as menu_macro %}

<ul class="dropdown-menu menu {{ size_class_map[size|default('sm')] }}{% if open is defined and open %} menu--shown{% endif %} {{ menuAlignment|default('start') == 'end' ? 'dropdown-menu-end' : 'dropdown-menu-start' }}{% if backgroundToken is defined and backgroundToken == 'background' %} layer-two{% endif %} {{ className|default('') }}"
    role="menu" tabindex="-1"
    {% if label is defined and label %}aria-label="{{ label|trans }}"{% endif %}
    {% if attributes is defined and attributes is not empty %}{% for attribute, attribute_value in attributes %} {{ attribute }}="{{ attribute_value }}"{% endfor %}{% endif %}>
    {{ menu_macro.menu_rows(items|default([]), size|default('sm')) }}
</ul>
