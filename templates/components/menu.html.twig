<!--
  ╔══════════════════════════════════════════════════════════════════════════╗
  ║  MENU COMPONENT — API (pass these from the parent include)               ║
  ╠══════════════════════════════════════════════════════════════════════════╣
  ║  backgroundToken   layer | background (extra surface class)              ║
  ║  label             spoken name for the whole menu (screen readers)        ║
  ║  menuAlignment     start | end  → Bootstrap aligns the panel             ║
  ║  open              true = force visible (adds Bootstrap .show)            ║
  ║  size              xs | sm | md | lg  → Carbon-style menu density        ║
  ║  className         extra classes on the outer <ul>                       ║
  ║  attributes        extra HTML attributes on the outer <ul>               ║
  ║  children          array of rows — see Twig comments in menu_rows below  ║
  ╠══════════════════════════════════════════════════════════════════════════╣
  ║  Row keys: menuItem, menuItemDivider, menuItemRadioGroup, menuItemGroup   ║
  ║  Divider:  use menuItemDivider: true (or any value; not false)           ║
  ╚══════════════════════════════════════════════════════════════════════════╝
-->

{# ═══════════════════════════════════════════════════════════════════════════ #}
{#  SHARED BITS                                                                #}
{#  • size_class_map → turns "sm" into class "menu--sm"                       #}
{#  • control_attributes → prints extra data-* / id / etc. on controls       #}
{# ═══════════════════════════════════════════════════════════════════════════ #}

{% set size_class_map = {
    'xs': 'menu--xs',
    'sm': 'menu--sm',
    'md': 'menu--md',
    'lg': 'menu--lg'
} %}

{% macro control_attributes(attrs) %}
{% if attrs is defined and attrs is not empty %}{% for name, value in attrs %} {{ name }}="{{ value }}"{% endfor %}{% endif %}
{% endmacro %}

{% macro menu_trace(nodes) %}
{% import _self as t %}
{% for row in nodes|default([]) %}
{% if row.menuItem is defined %}
{% set mi = row.menuItem %}
{% if mi.renderIcon is defined and mi.renderIcon %}i{% endif %}
{% if mi.children is defined and mi.children|length > 0 %}{{ t.menu_trace(mi.children) }}{% endif %}
{% elseif row.menuItemRadioGroup is defined %}s
{% set rg = row.menuItemRadioGroup %}
{% for raw in rg.children is defined ? rg.children : rg.items|default(rg.options|default([])) %}
{% set opt = raw.menuItem|default(raw) %}
{% if opt.renderIcon is defined and opt.renderIcon %}i{% endif %}
{% endfor %}
{% elseif row.menuItemGroup is defined %}s
{% set g = row.menuItemGroup %}
{% for raw in g.children is defined ? g.children : g.items|default([]) %}
{% set opt = raw.menuItemSelectable|default(raw) %}
{% if opt.renderIcon is defined and opt.renderIcon %}i{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
{% endmacro %}

{# ═══════════════════════════════════════════════════════════════════════════ #}
{#  menu_rows(rows, size)                                                      #}
{#  Renders ONE <ul>’s children: a list of <li>…</li> rows.                    #}
{#  Called from the root <ul>, and again inside a nested submenu <ul>.        #}
{# ═══════════════════════════════════════════════════════════════════════════ #}

{% macro menu_rows(rows, size) %}
{% import _self as m %}
{% for row in rows|default([]) %}

    {# ─────────────────────────────────────────────────────────────────────── #}
    {#  ROW TYPE: menuItem                                                     #}
    {#  One clickable line: either opens a child menu, links away, or fires    #}
    {#  a button action (no URL).                                              #}
    {# ─────────────────────────────────────────────────────────────────────── #}
    {% if row.menuItem is defined %}
        {% set mi = row.menuItem %}
        {% set item_class = 'menu-item dropdown-item' ~ (mi.disabled|default(false) ? ' menu-item--disabled' : '') ~ ((mi.kind|default('default')) == 'danger' ? ' menu-item--danger' : '') %}

        {# ···································································· #}
        {#  CASE A — This row OPENS ANOTHER MENU (chevron / “Share with…”)      #}
        {#  • The visible row is a <button> that Bootstrap treats as a second  #}
        {#    dropdown trigger (nested panel opens to the side).               #}
        {#  • The next sibling is a <ul> — we call menu_rows again on it.      #}
        {#                                                                      #}
        {#       <li class="dropend">                                           #}
        {#         ┌── <button>  label + arrow  (opens child)                  #}
        {#         └── <ul> …child rows…                                        #}
        {#       </li>                                                          #}
        {# ···································································· #}
        {% if mi.children is defined and mi.children|length > 0 %}
            <li class="dropend" role="none">

                {# —— the only focusable control on this row: expand child —— #}
                <button type="button" role="menuitem" class="{{ item_class }}" tabindex="0"
                    data-bs-toggle="dropdown"
                    data-bs-auto-close="outside"
                    aria-haspopup="true"
                    aria-expanded="false"
                    {% if mi.disabled|default(false) %}disabled aria-disabled="true"{% endif %}
                    {{ m.control_attributes(mi.attributes|default({})) }}>
                    <div class="menu-item__selection-icon"></div>
                    <div class="menu-item__icon">{% if mi.renderIcon is defined and mi.renderIcon %}<i class="{{ mi.renderIcon }}"></i>{% endif %}</div>
                    <div class="menu-item__label" dir="ltr">{{ mi.label|trans }}</div>
                    {% if mi.kind|default('default') == 'danger' %}
                        <span class="visually-hidden">{{ 'mautic.marketplace.menu.danger_hint'|trans }}</span>
                    {% endif %}
                    <div class="menu-item__shortcut"><i class="ri-arrow-right-s-line"></i></div>
                </button>

                {# —— panel that appears beside this row (same shapes as root) —— #}
                {% set _sub_sig = m.menu_trace(mi.children) %}
                <ul tabindex="0" class="dropdown-menu menu menu--{{ size }}{{ ('i' in _sub_sig) ? ' menu--with-icons' : '' }}{{ ('s' in _sub_sig) ? ' menu--with-selectable-items' : '' }}" role="menu" aria-label="{{ mi.label|trans }}">
                    {{ m.menu_rows(mi.children, size) }}
                </ul>
            </li>

        {# ···································································· #}
        {#  CASE B — This row is a NORMAL LINK (user goes to another page/URL) #}
        {#  • Use when menuItem has `href` set.                                #}
        {#                                                                      #}
        {#       <li>                                                           #}
        {#         └── <a href="…">  icon + label + optional shortcut           #}
        {#       </li>                                                        #}
        {# ···································································· #}
        {% elseif mi.href is defined and mi.href %}
            <li role="none">

                <a href="{{ mi.href }}" role="menuitem" class="{{ item_class }}"
                    {% if mi.disabled|default(false) %}aria-disabled="true" tabindex="-1"{% else %}tabindex="0"{% endif %}
                    {{ m.control_attributes(mi.attributes|default({})) }}>
                    <div class="menu-item__selection-icon"></div>
                    <div class="menu-item__icon">{% if mi.renderIcon is defined and mi.renderIcon %}<i class="{{ mi.renderIcon }}"></i>{% endif %}</div>
                    <div class="menu-item__label" dir="ltr">{{ mi.label|trans }}</div>
                    {% if mi.kind|default('default') == 'danger' %}
                        <span class="visually-hidden">{{ 'mautic.marketplace.menu.danger_hint'|trans }}</span>
                    {% endif %}
                    <div class="menu-item__shortcut">{% if mi.shortcut is defined and mi.shortcut %}{{ mi.shortcut|trans }}{% endif %}</div>
                </a>
            </li>

        {# ···································································· #}
        {#  CASE C — This row is a BUTTON (no URL — you wire click in JS)      #}
        {#  • Use when there is no `href` and no nested `children` menu.       #}
        {#                                                                      #}
        {#       <li>                                                           #}
        {#         └── <button>  icon + label + optional shortcut               #}
        {#       </li>                                                        #}
        {# ···································································· #}
        {% else %}
            <li role="none">

                <button type="button" role="menuitem" class="{{ item_class }}"
                    tabindex="{% if mi.disabled|default(false) %}-1{% else %}0{% endif %}"
                    {% if mi.disabled|default(false) %}disabled aria-disabled="true"{% endif %}
                    {{ m.control_attributes(mi.attributes|default({})) }}>
                    <div class="menu-item__selection-icon"></div>
                    <div class="menu-item__icon">{% if mi.renderIcon is defined and mi.renderIcon %}<i class="{{ mi.renderIcon }}"></i>{% endif %}</div>
                    <div class="menu-item__label" dir="ltr">{{ mi.label|trans }}</div>
                    {% if mi.kind|default('default') == 'danger' %}
                        <span class="visually-hidden">{{ 'mautic.marketplace.menu.danger_hint'|trans }}</span>
                    {% endif %}
                    <div class="menu-item__shortcut">{% if mi.shortcut is defined and mi.shortcut %}{{ mi.shortcut|trans }}{% endif %}</div>
                </button>
            </li>
        {% endif %}

    {# ─────────────────────────────────────────────────────────────────────── #}
    {#  ROW TYPE: menuItemDivider                                              #}
    {#  A horizontal rule between sections — not clickable.                   #}
    {#       <li class="menu-item-divider" role="separator"></li>               #}
    {# ─────────────────────────────────────────────────────────────────────── #}
    {% elseif row.menuItemDivider is defined and row.menuItemDivider is not same as(false) %}
        <li class="menu-item-divider" role="separator"></li>

    {# ─────────────────────────────────────────────────────────────────────── #}
    {#  ROW TYPE: menuItemRadioGroup                                           #}
    {#  “Pick exactly one” list (like export format).                         #}
    {#  • Outer <li> wraps an inner <ul role="group"> with radio-style rows.   #}
    {#  • Each option is either <a> or <button> depending on href.             #}
    {#                                                                      #}
    {#       <li class="menu-item-radio-group">                               #}
    {#         <ul role="group">                                              #}
    {#           <li><a or button>  radio row</li>  …                         #}
    {#         </ul>                                                          #}
    {#       </li>                                                            #}
    {# ─────────────────────────────────────────────────────────────────────── #}
    {% elseif row.menuItemRadioGroup is defined %}
        {% set rg = row.menuItemRadioGroup %}
        {% set rg_items = rg.children is defined ? rg.children : rg.items|default(rg.options|default([])) %}
        {% set rg_has_icons = false %}
        {% for raw in rg_items %}
            {% set opt = raw.menuItem|default(raw) %}
            {% set rg_has_icons = rg_has_icons or (opt.renderIcon is defined and opt.renderIcon) %}
        {% endfor %}
        <li class="menu-item-radio-group" role="none">

            <ul class="dropdown-menu show selectable menu--with-selectable-items{{ rg_has_icons ? ' menu--with-icons' : '' }}" role="group" aria-label="{{ rg.label|trans }}">
                {% for raw in rg_items %}
                    {% set opt = raw.menuItem|default(raw) %}
                    {% set is_checked = opt.selected|default(false) %}
                    {% set opt_class = 'menu-item dropdown-item' %}

                    {% if opt.href is defined and opt.href %}
                        <li role="none">

                            <a href="{{ opt.href }}" role="menuitemradio" class="{{ opt_class }}" aria-checked="{{ is_checked ? 'true' : 'false' }}" tabindex="0" {{ m.control_attributes(opt.attributes|default({})) }}>
                                <div class="menu-item__selection-icon">{% if is_checked %}<i class="ri-check-line"></i>{% endif %}</div>
                                <div class="menu-item__icon">{% if opt.renderIcon is defined and opt.renderIcon %}<i class="{{ opt.renderIcon }}"></i>{% endif %}</div>
                                <div class="menu-item__label" dir="ltr">{{ opt.label|trans }}</div>
                            </a>
                        </li>
                    {% else %}
                        <li role="none">

                            <button type="button" role="menuitemradio" class="{{ opt_class }}" aria-checked="{{ is_checked ? 'true' : 'false' }}" tabindex="0"
                                {% if opt.disabled|default(false) %}disabled aria-disabled="true"{% endif %}
                                {{ m.control_attributes(opt.attributes|default({})) }}>
                                <div class="menu-item__selection-icon">{% if is_checked %}<i class="ri-check-line"></i>{% endif %}</div>
                                <div class="menu-item__icon">{% if opt.renderIcon is defined and opt.renderIcon %}<i class="{{ opt.renderIcon }}"></i>{% endif %}</div>
                                <div class="menu-item__label" dir="ltr">{{ opt.label|trans }}</div>
                            </button>
                        </li>
                    {% endif %}
                {% endfor %}
            </ul>
        </li>

    {# ─────────────────────────────────────────────────────────────────────── #}
    {#  ROW TYPE: menuItemGroup                                                #}
    {#  “Turn features on/off” — multiple can be active (Bold + Italic).      #}
    {#  • Same idea as radio group, but role=menuitemcheckbox + checkmarks.   #}
    {#                                                                      #}
    {#       <li class="menu-item-group">                                   #}
    {#         <ul role="group">                                              #}
    {#           <li><a or button>  checkbox row + optional shortcut</li>     #}
    {#         </ul>                                                          #}
    {#       </li>                                                            #}
    {# ─────────────────────────────────────────────────────────────────────── #}
    {% elseif row.menuItemGroup is defined %}
        {% set g = row.menuItemGroup %}
        {% set g_rows = g.children is defined ? g.children : g.items|default([]) %}
        {% set g_has_icons = false %}
        {% for raw in g_rows %}
            {% set opt = raw.menuItemSelectable|default(raw) %}
            {% set g_has_icons = g_has_icons or (opt.renderIcon is defined and opt.renderIcon) %}
        {% endfor %}
        <li class="menu-item-group" role="none">

            <ul class="dropdown-menu show selectable menu--with-selectable-items{{ g_has_icons ? ' menu--with-icons' : '' }}" role="group" aria-label="{{ g.label|trans }}">
                {% for raw in g_rows %}
                    {% set opt = raw.menuItemSelectable|default(raw) %}
                    {% set is_on = opt.selected|default(opt.defaultSelected|default(false)) %}
                    {% set opt_class = 'menu-item dropdown-item' ~ (is_on ? ' menu-item-selectable--selected' : '') %}
                    {% if opt.href is defined and opt.href %}
                        <li role="none">

                            <a href="{{ opt.href }}" role="menuitemcheckbox" class="{{ opt_class }}" aria-checked="{{ is_on ? 'true' : 'false' }}" tabindex="0" {{ m.control_attributes(opt.attributes|default({})) }}>
                                <div class="menu-item__selection-icon">{% if is_on %}<i class="ri-check-line"></i>{% endif %}</div>
                                <div class="menu-item__icon">{% if opt.renderIcon is defined and opt.renderIcon %}<i class="{{ opt.renderIcon }}"></i>{% endif %}</div>
                                <div class="menu-item__label" dir="ltr">{{ opt.label|trans }}</div>
                                <div class="menu-item__shortcut">{% if opt.shortcut is defined and opt.shortcut %}{{ opt.shortcut|trans }}{% endif %}</div>
                            </a>
                        </li>
                    {% else %}
                        <li role="none">

                            <button type="button" role="menuitemcheckbox" class="{{ opt_class }}" aria-checked="{{ is_on ? 'true' : 'false' }}" tabindex="0"
                                {% if opt.disabled|default(false) %}disabled aria-disabled="true"{% endif %}
                                {{ m.control_attributes(opt.attributes|default({})) }}>
                                <div class="menu-item__selection-icon">{% if is_on %}<i class="ri-check-line"></i>{% endif %}</div>
                                <div class="menu-item__icon">{% if opt.renderIcon is defined and opt.renderIcon %}<i class="{{ opt.renderIcon }}"></i>{% endif %}</div>
                                <div class="menu-item__label" dir="ltr">{{ opt.label|trans }}</div>
                                <div class="menu-item__shortcut">{% if opt.shortcut is defined and opt.shortcut %}{{ opt.shortcut|trans }}{% endif %}</div>
                            </button>
                        </li>
                    {% endif %}
                {% endfor %}
            </ul>
        </li>
    {% endif %}
{% endfor %}
{% endmacro %}

{# ═══════════════════════════════════════════════════════════════════════════ #}
{#  ROOT: the visible floating panel Bootstrap positions under the trigger     #}
{#                                                                      #}
{#    <ul class="dropdown-menu menu …">   ← this file ends here            #}
{#      …menu_rows…                                                       #}
{#    </ul>                                                               #}
{# ═══════════════════════════════════════════════════════════════════════════ #}

{% import _self as menu_macro %}
{% set _root_sig = menu_macro.menu_trace(children|default([])) %}

<ul class="dropdown-menu menu {{ size_class_map[size|default('sm')] }}{% if open is defined and open %} show{% endif %}{{ ('i' in _root_sig) ? ' menu--with-icons' : '' }}{{ ('s' in _root_sig) ? ' menu--with-selectable-items' : '' }} {{ menuAlignment|default('start') == 'end' ? 'dropdown-menu-end' : 'dropdown-menu-start' }}{% if backgroundToken is defined and backgroundToken == 'background' %} layer-two{% endif %} {{ className|default('') }}"
    role="menu" tabindex="-1"
    {% if label is defined and label %}aria-label="{{ label|trans }}"{% endif %}
    {% if attributes is defined and attributes is not empty %}{% for attribute, attribute_value in attributes %} {{ attribute }}="{{ attribute_value }}"{% endfor %}{% endif %}>
    {{ menu_macro.menu_rows(children|default([]), size|default('sm')) }}
</ul>
