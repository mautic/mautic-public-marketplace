{% set ctaIcons = {
    'local': 'ri-arrow-right-line',
    'jump': 'ri-arrow-down-line',
    'external': 'ri-external-link-line',
    'new tab': 'ri-window-2-line',
    'download': 'ri-download-line',
    'video': 'ri-play-fill',
    'pdf': 'ri-file-pdf-2-line',
    'blog': 'ri-article-line',
    'modal': 'ri-rectangle-line',
    'email': 'ri-mail-line',
    'schedule': 'ri-calendar-line',
    'chat': 'ri-chat-1-line',
    'call': 'ri-phone-line'
} %}

{% set type = type|default('default') %}
{% set aspectRatio = aspectRatio|default(type == 'link' ? '2:1' : '4:3') %}
{% set ctaType = ctaType|default('local') %}

{% set common_image_content %}
    {% if image is defined %}
        <div class="card__image-wrapper d-flex {% if type == 'static' or type == 'default' %}ratio ratio-4x3{% endif %}">
            <img class="image__img object-fit-cover" src="{{ asset(image.src) }}" alt="{{ image.alt|trans }}">
        </div>
    {% endif %}
{% endset %}

{% set common_eyebrow_content %}
    {% if eyebrow is defined %}
        <div class="card__eyebrow-wrapper type-label-02 text-secondary mb-8">{{ eyebrow|trans }}</div>
    {% endif %}
{% endset %}

{% set common_heading_content %}
    {% if heading is defined %}
        <div class="card__heading-wrapper">
            <h3 class="card-heading {% if type == 'feature--large' %}type-fluid-heading-04{% else %}type-heading-0{{ type == 'link' ? '2' : '3' }}{% endif %} {% if type == 'feature--large' %}mb-32{% elseif type != 'pictogram' and type != 'link' %}mb-64{% endif %} text-break">{{ heading|trans }}</h3>
        </div>
    {% endif %}
{% endset %}

{% set common_copy_content %}
    {% if copy is defined %}
        <div class="card__copy type-body-02 pr-32 mb-32 {% if type == 'pictogram' %}mt-32{% endif %}">{{ copy|trans }}</div>
    {% endif %}
{% endset %}

{% set common_custom_content %}
    {% if customContent is defined %}
        <div class="card__custom__content">{{ customContent|raw }}</div>
    {% endif %}
{% endset %}

{% set common_cta_copy_content %}
    {% if ctaCopy is defined %}
        <div class="card__cta__copy link-primary">{{ ctaCopy|trans }}</div>
    {% endif %}
{% endset %}

{% set common_footer_copy_content %}
    {% if footerCopy is defined %}
        <div class="card__footer__copy">{{ footerCopy|trans }}</div>
    {% endif %}
{% endset %}

{% set common_icon_content %}
    {% if icon is defined %}
        <i class="{{ ctaIcons[ctaType] }} link-primary ri-lg ms-auto" aria-hidden="true"></i>
    {% endif %}
{% endset %}

{% set common_tags_content %}
    {% if tags is defined %}
        <div class="d-flex flex-wrap mt-12 gap-4">
            {% include 'components/tags.html.twig' with {'tags': tags} %}
        </div>
    {% endif %}
{% endset %}

{% set common_pictogram_content %}
    {% if type == 'pictogram' and pictogram is defined %}
        <div class="card__pictogram-wrapper mt-a">
            {% include 'components/pictogram.html.twig' with {'pictogram': pictogram, 'size': 48} only %}
        </div>
    {% endif %}
{% endset %}

    {# === STATIC TYPE === #}
    {% if type == 'static' %}
        {% set cardContent %}
            {{ common_image_content }}
            <div class="card__wrapper" aspect-ratio="{{ aspectRatio }}">
                <div class="card__content">
                    {{ common_eyebrow_content }}
                    {{ common_heading_content }}
                    {{ common_copy_content }}
                    {{ common_tags_content }}
                    <div class="card__footer-wrapper">
                        {% if cta is defined %}
                            {% include 'components/button.html.twig' with {'buttons': [cta|merge({'variant': 'link', 'icon': 'ri-arrow-right-line', 'attributes': {'class': 'type-body-02'}})]} %}
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endset %}
        {% include 'components/tile.html.twig' with {
            type: 'base',
            content: cardContent,
            className: 'card p-0' ~ (disabled is defined ? ' tile--disabled' : ''),
        } %}

    {# === LOGO TYPE === #}
    {% elseif type == 'logo' %}
        {% set cardContent %}
            {{ common_image_content }}
            <div class="card__wrapper">
                <div class="card__content">
                    {{ common_eyebrow_content }}
                    {{ common_heading_content }}
                    {{ common_copy_content }}
                    {{ common_tags_content }}
                </div>
            </div>
        {% endset %}
        {% include 'components/tile.html.twig' with {
            type: 'clickable',
            content: cardContent,
            className: 'card p-0 card--link' ~ (disabled is defined ? ' tile--disabled' : ''),
            icon: ctaIcons[ctaType],
            href: href,
        } %}

    {# === LINK TYPE === #}
    {% elseif type == 'link' %}
        {% set cardContent %}
            <div class="card__wrapper" aspect-ratio="2:1">
                <div class="card__content">
                    {{ common_heading_content }}
                    {{ common_copy_content }}
                </div>
            </div>
            
        {% endset %}
        {% include 'components/tile.html.twig' with {
            type: 'clickable',
            content: cardContent,
            className: 'card p-0 card--link' ~ (disabled is defined ? ' tile--disabled' : ''),
            icon: ctaIcons[ctaType],
            href: href,
        } %}

    {# === PICTOGRAM TYPE === #}
    {% elseif type == 'pictogram' %}
        {% set cardContent %}
            <div class="card__wrapper d-flex fd-column">
                <div class="card__content d-flex fd-column fg-1 pb-64">
                    {{ common_heading_content }}
                    {{ common_copy_content }}
                    {{ common_pictogram_content }}
                </div>
            </div>
        {% endset %}
        {% if href is defined and href is not empty %}
            {% include 'components/tile.html.twig' with {
                type: 'clickable',
                content: cardContent,
                className: 'card p-0 card--link' ~ (disabled is defined ? ' tile--disabled' : ''),
                icon: ctaIcons[ctaType],
                href: href,
            } %}
        {% else %}
            {% include 'components/tile.html.twig' with {
                type: 'base',
                content: cardContent,
                className: 'card p-0' ~ (disabled is defined ? ' tile--disabled' : ''),
            } %}
        {% endif %}

    {# === DEFAULT TYPE === #}
    {% elseif type == 'default' %}
        {% set cardContent %}
            {{ common_image_content }}
            <div class="card__wrapper aspect-ratio="{{ aspectRatio }}">
                <div class="card__content">
                    {{ common_eyebrow_content }}
                    {{ common_heading_content }}
                    {{ common_copy_content }}
                    {{ common_custom_content }}
                    {{ common_tags_content }}
                </div>
                <div class="card__footer">
                    {{ common_cta_copy_content }}
                    {{ common_footer_copy_content }}
                    {{ common_icon_content }}
                </div>
            </div>
        {% endset %}
        {% include 'components/tile.html.twig' with {
            type: 'clickable',
            content: cardContent,

            className: 'card p-0 card--link' ~ (disabled is defined ? ' tile--disabled' : ''),
            href: href,
        } only %}

    {# === FEATURE TYPE === #}
    {% elseif type == 'feature' %}
        {% set cardContent %}
        <div class="d-flex fd-column fd-row-md">
            <div class="d-flex fg-1 fs-1 fb-0 ratio ratio-1x1">
                {{ common_image_content }}
            </div>
            <div class="fg-1 fs-1 fb-0">
            <div class="card__wrapper ratio ratio-1x1">
                <div class="card__content">
                    {{ common_heading_content }}
                </div>
            </div>
            </div>
        </div>
        {% endset %}
        {% include 'components/tile.html.twig' with {
            type: 'clickable',
            content: cardContent,
            className: 'card p-0 card--link',
            href: href,
        } %}

        {# === FEATURE TYPE === #}
    {% elseif type == 'feature--large' %}
        {% set cardContent %}
        <div class="d-flex fd-column fd-row-lg">
            <div class="d-flex fg-1 fs-1 fb-0 ratio ratio-1x1">
                {{ common_image_content }}
            </div>
            <div class="fg-1 fs-1 fb-0">
            <div class="card__wrapper ratio ratio-1x1">
                <div class="card__content pa-32">
                    {{ common_eyebrow_content }}
                    {{ common_heading_content }}
                    {{ common_copy_content }}
                </div>
            </div>
            </div>
        </div>
        {% endset %}
        {% include 'components/tile.html.twig' with {
            type: 'clickable',
            content: cardContent,
            className: 'card p-0 card--link',
            href: href,
            icon: ctaIcons[ctaType],
        } %}
    {% endif %}
