{% macro page_label(active) %}
    {% if active %}
    <span class="pagination-nav__accessibility-label">{{ 'mautic.marketplace.pagination_nav.active_page'|trans }}</span>
    {% else %}
    <span class="pagination-nav__accessibility-label">{{ 'mautic.marketplace.pagination_nav.page_label'|trans }}</span>
    {% endif %}
{% endmacro %}

{% macro page_control(p, active, route, routeQuery, pageSize) %}
    {% import _self as nav %}
    {% if route is not null %}
        <a
            href="{{ path(route, routeQuery|merge({offset: (p - 1) * pageSize})) }}"
            class="pagination-nav__page{{ active ? ' pagination-nav__page--active' : '' }}"
            {% if active %}aria-current="page"{% endif %}
        >{{ nav.page_label(active) }}{{ p }}</a>
    {% else %}
        <button
            type="button"
            class="pagination-nav__page{{ active ? ' pagination-nav__page--active' : '' }}"
            data-page="{{ p }}"
            {% if active %}aria-current="page"{% endif %}
        >{{ nav.page_label(active) }}{{ p }}</button>
    {% endif %}
{% endmacro %}

{% set backwardText = backwardText|default('marketplace.index.pagination.previous') %}
{% set backwardHref = backwardHref|default('') %}
{% set disabled = disabled|default(false) %}
{% set forwardText = forwardText|default('marketplace.index.pagination.next') %}
{% set forwardHref = forwardHref|default('') %}
{% set id = id|default('pagination-nav') %}
{% set page = page|default(1) %}
{% set pageSize = pageSize|default(10) %}
{% set route = route|default(null) %}
{% set routeQuery = routeQuery|default({}) %}
{% set size = size|default('md') %}
{% set totalItems = totalItems|default(null) %}
{% set totalPages = totalPages|default(
    totalItems is not null and pageSize > 0
        ? max(1, (totalItems / pageSize)|round(0, 'ceil'))
        : 1
) %}
{% if route is not null and backwardHref == '' and page > 1 %}
    {% set backwardHref = path(route, routeQuery|merge({offset: (page - 2) * pageSize})) %}
{% endif %}
{% if route is not null and forwardHref == '' and page < totalPages %}
    {% set forwardHref = path(route, routeQuery|merge({offset: page * pageSize})) %}
{% endif %}
{% if page <= 1 or disabled %}
    {% set backwardHref = '' %}
{% endif %}
{% if page >= totalPages or disabled %}
    {% set forwardHref = '' %}
{% endif %}
{% set effectiveShown = totalPages < 4 ? totalPages : max(4, 10) %}
{% set overflow = totalPages > effectiveShown %}
{% set numLeading = overflow ? min(effectiveShown - 2, totalPages - 2) : totalPages %}
{% set numLeading = numLeading < 1 ? 1 : numLeading %}
{% set middleStart = numLeading + 1 %}
{% set middleEnd = totalPages - 1 %}
{% set pageInMiddle = overflow and middleStart <= middleEnd and page >= middleStart and page <= middleEnd %}
{% set middleRows = middleStart <= middleEnd ? range(middleStart, middleEnd)|map(p => { value: (p - 1) * pageSize, label: p }) : [] %}
{% if overflow and middleStart <= middleEnd and not pageInMiddle %}
    {% set middleRows = [{ value: '', label: '' }]|merge(middleRows) %}
{% endif %}
{% set selectValue = pageInMiddle ? (page - 1) * pageSize : '' %}
{% import _self as nav %}

<nav class="pagination-nav pagination-nav--{{ size }}" aria-label="{{ 'mautic.marketplace.pagination_nav.aria'|trans }}">
    <ul class="pagination-nav__list">
        <li class="pagination-nav__list-item">
            <div class="tooltip-trigger__wrapper">
                {% include 'components/button.html.twig' with {
                    buttons: [
                        ({
                            label: backwardText,
                            variant: 'ghost',
                            icon_only: true,
                            icon: 'ri-arrow-left-s-fill ri-lg',
                            attributes: (page <= 1 or disabled ? {
                                class: 'pagination-nav__edge-btn btn--disabled',
                                disabled: 'disabled',
                            } : {
                                class: 'pagination-nav__edge-btn',
                                'data-bs-toggle': 'tooltip',
                                'data-bs-placement': 'top',
                                'data-bs-title': backwardText|trans,
                            })|merge({ id: id ~ '-backward' })|merge(page > 1 and not disabled and backwardHref != '' ? {} : { type: 'button' }),
                        })|merge(page > 1 and not disabled and backwardHref != '' ? { href: backwardHref } : {}),
                    ]
                } only %}
            </div>
        </li>
        {% if not overflow %}
            {% for p in 1..totalPages %}
                <li class="pagination-nav__list-item">{{ nav.page_control(p, p == page, route, routeQuery, pageSize) }}</li>
            {% endfor %}
        {% else %}
            {% for p in 1..numLeading %}
                <li class="pagination-nav__list-item">{{ nav.page_control(p, p == page, route, routeQuery, pageSize) }}</li>
            {% endfor %}
            {% if middleStart <= middleEnd %}
                <li class="pagination-nav__list-item">
                    <div class="pagination-nav__select{{ pageInMiddle ? ' pagination-nav__select--active' : '' }}">
                        {% if route is not null %}
                            <div class="form-item">
                                {% include 'components/select.html.twig' with {
                                    id: id ~ '-overflow',
                                    name: 'offset',
                                    label: null,
                                    options: middleRows,
                                    value: selectValue,
                                    disabled: disabled,
                                    wrapper_class: '',
                                    attributes: {
                                        class: 'pagination-nav__page pagination-nav__page--select',
                                        'aria-label': 'mautic.marketplace.pagination_nav.select_label'|trans({'%pages%': totalPages}),
                                        title: 'mautic.marketplace.pagination_nav.select_label'|trans({'%pages%': totalPages}),
                                    }
                                } only %}
                            </div>
                        {% else %}
                            <select
                                id="{{ id }}-overflow"
                                class="form-select pagination-nav__page pagination-nav__page--select"
                                aria-label="{{ 'mautic.marketplace.pagination_nav.select_label'|trans({'%pages%': totalPages}) }}"
                                {% if disabled %}disabled{% endif %}
                            >
                                {% if not pageInMiddle %}<option value="" selected hidden></option>{% endif %}
                                {% for p in middleStart..middleEnd %}
                                    <option value="{{ (p - 1) * pageSize }}"{% if p == page %} selected{% endif %}>{{ p }}</option>
                                {% endfor %}
                            </select>
                        {% endif %}
                        <div class="pagination-nav__select-icon-wrapper{{ pageInMiddle ? ' pagination-nav__page--active' : '' }}">
                            <svg class="pagination-nav__select-icon" width="16" height="16" viewBox="0 0 32 32" aria-hidden="true" focusable="false" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><circle cx="8" cy="16" r="2"/><circle cx="16" cy="16" r="2"/><circle cx="24" cy="16" r="2"/></svg>
                        </div>
                    </div>
                </li>
            {% endif %}
            {% if totalPages > numLeading %}
                <li class="pagination-nav__list-item">{{ nav.page_control(totalPages, totalPages == page, route, routeQuery, pageSize) }}</li>
            {% endif %}
        {% endif %}
        <li class="pagination-nav__list-item">
            <div class="tooltip-trigger__wrapper">
                {% include 'components/button.html.twig' with {
                    buttons: [
                        ({
                            label: forwardText,
                            variant: 'ghost',
                            icon_only: true,
                            icon: 'ri-arrow-right-s-fill ri-lg',
                            attributes: (page >= totalPages or disabled ? {
                                class: 'pagination-nav__edge-btn btn--disabled',
                                disabled: 'disabled',
                            } : {
                                class: 'pagination-nav__edge-btn',
                                'data-bs-toggle': 'tooltip',
                                'data-bs-placement': 'top',
                                'data-bs-title': forwardText|trans,
                            })|merge({ id: id ~ '-forward' })|merge(page < totalPages and not disabled and forwardHref != '' ? {} : { type: 'button' }),
                        })|merge(page < totalPages and not disabled and forwardHref != '' ? { href: forwardHref } : {}),
                    ]
                } only %}
            </div>
        </li>
    </ul>
    <div class="pagination-nav__status" aria-live="polite" aria-atomic="true">
        {{ 'mautic.marketplace.pagination_nav.status'|trans({'%current%': page, '%total%': totalPages}) }}
    </div>
</nav>
