<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Mautic Marketplace{% endblock %}</title>
    <script src="{{ asset('assets/marketplace.js') }}" defer data-turbo-track="reload"></script>
    {% block importmap %}{{ importmap('app') }}{% endblock %}
</head>
<body>
      {% include 'components/uishell.html.twig' with {
        Header: {
            ariaLabel: 'mautic.marketplace.header.aria_label',
            children: {
                skipToContent: {
                    href: '#main-content',
                    children: 'mautic.marketplace.skip_to_content'
                },
                HeaderName: {
                    prefix: '',
                    children: 'mautic.marketplace.title',
                    href: path('marketplace_homepage')
                },
                HeaderNavigation: {
                    children: [
                        {
                            HeaderMenuItem: {
                                href: path('marketplace_index'),
                                children: 'mautic.marketplace.header.browse_templates'
                            }
                        }
                    ]|merge(app.user ? [
                        {
                            HeaderMenuItem: {
                                href: path('marketplace_upload_package'),
                                children: 'mautic.marketplace.header.upload_package'
                            }
                        }
                    ] : [])
                },
                HeaderGlobal: {
                    children: app.user ? [
                        {
                            HeaderGlobalDropdown: {
                                ariaLabel: 'mautic.marketplace.header.account',
                                renderDropdownIcon: 'ri-account-circle-line',
                                renderMenuContent: [
                                    {
                                        menuItem: {
                                            href: path('profile_page'),
                                            label: 'mautic.marketplace.header.my_profile'
                                        }
                                    },
                                    {
                                        menuItem: {
                                            href: path('auth_logout'),
                                            label: 'mautic.marketplace.header.logout',
                                            attributes: {
                                                'data-turbo': 'false'
                                            }
                                        }
                                    }
                                ]
                            }
                        }
                    ] : [
                        {
                            HeaderGlobalAction: {
                                href: path('auth_login', { returnTo: app.request.requestUri }),
                                renderActionIcon: 'ri-login-box-line',
                                ariaLabel: 'mautic.marketplace.header.login',
                                attributes: {
                                    'data-turbo': 'false'
                                }
                            }
                        }
                    ]
                }
            }
        }
    } %}
    <main id="main-content">

            {% for message in app.flashes('success') %}
                <div class="alert alert--success mb-16">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="alert alert--error mb-16">{{ message }}</div>
            {% endfor %}
            {% block body %}{% endblock %}

    </main>
</body>
</html>
