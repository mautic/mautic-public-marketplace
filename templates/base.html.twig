<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Mautic Marketplace{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <script src="{{ asset('assets/marketplace.js') }}" defer data-turbo-track="reload"></script>
    {% block importmap %}{{ importmap('app') }}{% endblock %}
</head>
<body data-auth0-domain="{{ auth0_domain|default('') }}"
      data-auth0-client-id="{{ auth0_client_id|default('') }}">
      {% include 'components/uishell.html.twig' with {
        Header: {
            ariaLabel: 'mautic.marketplace.header.aria_label',
            children: {
                skipToContent: {
                    href: '#main-content',
                    children: 'mautic.marketplace.skip_to_content'
                },
                HeaderName: {
                    prefix: '',
                    children: 'mautic.marketplace.title',
                    href: path('marketplace_homepage')
                },
                HeaderNavigation: {
                    children: [
                        {
                            HeaderMenuItem: {
                                href: path('marketplace_index'),
                                children: 'mautic.marketplace.header.browse_templates'
                            }
                        }
                    ]
                }
            }
        }
    } %}
    <main>
        <div class="container mt-48">
            {% block body %}{% endblock %}
        </div>
    </main>
</body>
</html>
