<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Mautic Marketplace{% endblock %}</title>
    <script src="{{ asset('assets/marketplace.js') }}" defer data-turbo-track="reload"></script>
    {% block importmap %}{{ importmap('app') }}{% endblock %}
</head>
<body>
      {% set authMenu %}
          <a class="dropdown-item" href="{{ path('profile_page') }}">{{ 'mautic.marketplace.header.my_profile'|trans }}</a>
          <a class="dropdown-item" href="{{ path('auth_logout') }}" data-turbo="false">{{ 'mautic.marketplace.header.logout'|trans }}</a>
      {% endset %}

      {% include 'components/uishell.html.twig' with {
        Header: {
            ariaLabel: 'mautic.marketplace.header.aria_label',
            children: {
                skipToContent: {
                    href: '#main-content',
                    children: 'mautic.marketplace.skip_to_content'
                },
                HeaderName: {
                    prefix: '',
                    children: 'mautic.marketplace.title',
                    href: path('marketplace_homepage')
                },
                HeaderNavigation: {
                    children: [
                        {
                            HeaderMenuItem: {
                                href: path('marketplace_index'),
                                children: 'mautic.marketplace.header.browse_templates'
                            }
                        }
                    ]
                },
                HeaderGlobal: {
                    children: app.user ? [
                        {
                            HeaderGlobalDropdown: {
                                ariaLabel: 'mautic.marketplace.header.account',
                                renderDropdownIcon: 'ri-account-circle-line',
                                renderMenuContent: authMenu
                            }
                        }
                    ] : [
                        {
                            HeaderGlobalAction: {
                                href: path('auth_login', { returnTo: app.request.requestUri }),
                                renderActionIcon: 'ri-login-box-line',
                                ariaLabel: 'mautic.marketplace.header.login',
                                attributes: {
                                    'data-turbo': 'false'
                                }
                            }
                        }
                    ]
                }
            }
        }
    } %}
    <main id="main-content">
        <div class="container mt-48">
            {% for message in app.flashes('success') %}
                <div class="alert alert--success mb-16">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="alert alert--error mb-16">{{ message }}</div>
            {% endfor %}
            {% block body %}{% endblock %}
        </div>
    </main>
</body>
</html>
