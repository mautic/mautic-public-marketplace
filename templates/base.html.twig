<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Mautic Marketplace{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('assets/bootstrap.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/marketplace.css') }}">
</head>
<body>
    <header>
        <div class="container">
            <strong>Mautic Marketplace</strong>
        </div>
    </header>
    <main>
        <div class="container">
            {% block body %}{% endblock %}
        </div>
    </main>
    <script src="{{ asset('assets/bootstrap.bundle.min.js') }}" defer></script>
    <script src="{{ asset('assets/marketplace.js') }}" defer></script>
</body>
</html>
