<div class="profile-user-info">
    {% if user.picture %}
        <img src="{{ user.picture }}" alt="User avatar" width="80" height="80" style="border-radius: 50%;">
    {% endif %}
    <h2>{{ user.name|default('Anonymous') }}</h2>
    <p>{{ user.email }}</p>
    <button id="profile-logout-btn" type="button" class="cds--btn cds--btn--tertiary cds--btn--sm">Log out</button>
</div>

<section class="profile-reviews-section">
    <h3>My Reviews</h3>
    {% if reviews is empty %}
        <p>No reviews yet.</p>
    {% else %}
        {% for review in reviews %}
            <div class="profile-review-item mb-16">
                <div>
                    <strong>{{ review.objectId }}</strong>
                    <span>
                        {% for i in 1..5 %}
                            {% if i <= review.rating %}&#9733;{% else %}&#9734;{% endif %}
                        {% endfor %}
                    </span>
                </div>
                <p>{{ review.review }}</p>
                <small>{{ review.created_at|date('M j, Y') }}</small>
            </div>
        {% endfor %}
    {% endif %}
</section>
