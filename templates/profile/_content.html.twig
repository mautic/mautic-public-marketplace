<div class="profile-user-info" id="profile-content">
    {% if app.user.picture %}
        <img src="{{ app.user.picture }}" alt="User avatar" width="80" height="80" style="border-radius: 50%;">
    {% endif %}
    <h2>{{ app.user.name|default('Anonymous') }}</h2>
    <p>{{ app.user.email }}</p>
    <a href="{{ path('auth_logout') }}" class="cds--btn cds--btn--tertiary cds--btn--sm" data-turbo="false">Log out</a>
</div>

<section class="profile-reviews-section">
    <h3>My Reviews</h3>
    {% if reviews is empty %}
        <p>No reviews yet.</p>
    {% else %}
        {% for review in reviews %}
            <div class="profile-review-item mb-16">
                <div>
                    <strong>{{ review.objectId }}</strong>
                    <span>
                        {% for i in 1..5 %}
                            {% if i <= review.rating %}&#9733;{% else %}&#9734;{% endif %}
                        {% endfor %}
                    </span>
                </div>
                <p>{{ review.review }}</p>
                <small>{{ review.created_at|date('M j, Y') }}</small>
            </div>
        {% endfor %}
    {% endif %}
</section>

<section class="profile-packages-section mt-32">
    <h3>My Packages</h3>
    {% if uploaded_packages is empty %}
        <p>No uploaded packages yet.</p>
    {% else %}
        <div class="d-grid gap-16">
            {% for package in uploaded_packages %}
                <div class="profile-package-item">
                    <strong>{{ package.displayname|default(package.name) }}</strong>
                    <p class="mb-4">{{ package.description|default('No description available.') }}</p>
                    <a href="{{ path('marketplace_detail', { package: package.name }) }}">{{ package.name }}</a>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</section>
