{% extends 'base.html.twig' %}

{% block title %}{{ name }}{% endblock %}

{% block body %}
    {% if error %}
        <p class="muted">{{ error }}</p>
    {% endif %}

    {% if package %}
        <p class="muted pt-16">
            <a href="{{ path('marketplace_index') }}">&larr; {{ 'mautic.marketplace.detail.back'|trans }}</a>
        </p>
        {% set color = (
            package.type == 'mautic-plugin' ? '#4e5e9e' :
            package.type == 'mautic-theme' ? '#00b49d' :
            package.type == 'mautic-resource' ? '#fdb933' :
            '#ad9bd3'
        ) %}
        {% set type_label = package.type == 'mautic-plugin' ? 'mautic.marketplace.detail.type.plugin' :
            package.type == 'mautic-theme' ? 'mautic.marketplace.detail.type.theme' :
            package.type == 'mautic-resource' ? 'mautic.marketplace.detail.type.resource' :
            'mautic.marketplace.detail.type.other' %}
        {% set version_keys_sorted = package.versions ? (package.versions|keys|sort|reverse) : [] %}
        {% set latest_package_version = version_keys_sorted|length > 0 ? version_keys_sorted|first : null %}
        {% set latest_mautic_version = (latest_package_version and package.versions[latest_package_version].smv is defined) ? package.versions[latest_package_version].smv : null %}
        {% set leadspace_tags = [{ label: type_label|trans, color: 'gray' }] %}
        {% if latest_mautic_version %}
            {% set leadspace_tags = leadspace_tags|merge([{ label: 'mautic.marketplace.detail.latest_mautic_supported'|trans({ '%version%': latest_mautic_version }), color: 'blue' }]) %}
        {% endif %}
        <div class="mx-n16 mx-lg-n32">
        {% include 'components/lead-space.html.twig' with {
            variant: 'short',
            heading: package.displayName ?: package.name,
            description: package.description,
            gradientStyleScheme: 'without-gradient',
            gradientStyleSchemeColor: color,
            tags: leadspace_tags,
        } %}
        </div>

            {% include 'marketplace/detail/section--description.html.twig' %}
            {% include 'marketplace/detail/section--gallery.html.twig' %}
            {% include 'marketplace/detail/section--install-instructions.html.twig' %}

        <section class="section">
            <h2>{{ 'mautic.marketplace.detail.reviews.heading'|trans }}</h2>
            {% if package.reviews %}
                {% set hasReview = false %}
                {% for key, review in package.reviews %}
                    {% if review.rating is not null or review.review is not null %}
                        {% set hasReview = true %}
                        <div class="review-card">
                            <div><strong>{{ review.name ?? key }}</strong></div>
                            {% if review.rating is not null %}
                                <div class="review-card__meta">{{ 'mautic.marketplace.detail.reviews.rating'|trans({ '%rating%': review.rating }) }}</div>
                            {% endif %}
                            {% if review.review %}
                                <div>{{ review.review }}</div>
                            {% endif %}
                        </div>
                    {% endif %}
                {% endfor %}
                {% if not hasReview %}
                    <p class="muted">{{ 'mautic.marketplace.detail.reviews.empty'|trans }}</p>
                {% endif %}
            {% else %}
                <p class="muted">{{ 'mautic.marketplace.detail.reviews.empty'|trans }}</p>
            {% endif %}
        </section>

        <section class="section" id="marketplace-review-container"
            data-auth0-domain="{{ auth0_domain }}"
            data-auth0-client-id="{{ auth0_client_id }}"
            data-api-url="{{ path('review_api_submit', {package: name}) }}"
            data-package-name="{{ name }}">
            <h2>{{ 'mautic.marketplace.detail.review_form.heading'|trans }}</h2>

            <div id="auth-loading">
                <p class="muted">{{ 'mautic.marketplace.detail.review_form.loading_authentication'|trans }}</p>
            </div>

            <div id="auth-login" style="display:none">
                <button type="button" id="auth0-login-btn" class="bx--btn bx--btn--primary">
                    {{ 'mautic.marketplace.detail.review_form.login'|trans }}
                </button>
            </div>

            <div id="auth-form" style="display:none">
                <p class="muted">{{ 'mautic.marketplace.detail.review_form.logged_in_as'|trans }} <strong id="auth-user-name"></strong>
                    (<a href="#" id="auth0-logout-btn">{{ 'mautic.marketplace.detail.review_form.logout'|trans }}</a>)
                </p>
                <form id="review-form" class="review-form">
                    <div class="review-form__stars">
                        <label>{{ 'mautic.marketplace.detail.review_form.rating'|trans }}</label>
                        <div id="rating-stars" class="star-rating">
                            <span class="star-icon" data-rating="1">&#9733;</span>
                            <span class="star-icon" data-rating="2">&#9733;</span>
                            <span class="star-icon" data-rating="3">&#9733;</span>
                            <span class="star-icon" data-rating="4">&#9733;</span>
                            <span class="star-icon" data-rating="5">&#9733;</span>
                        </div>
                        <input type="hidden" id="rating" name="rating" value="0">
                    </div>
                    <div class="review-form__text">
                        <label for="review">{{ 'mautic.marketplace.detail.review_form.review'|trans }}</label>
                        <textarea id="review" name="review" class="bx--text-area" rows="4" placeholder="{{ 'mautic.marketplace.detail.review_form.review_placeholder'|trans }}"></textarea>
                    </div>
                    <button type="submit" id="submit-btn" class="bx--btn bx--btn--primary">{{ 'mautic.marketplace.detail.review_form.submit'|trans }}</button>
                </form>
            </div>

            <div id="review-error" class="alert alert--error" style="display:none"></div>
            <div id="review-success" class="alert alert--success" style="display:none"></div>
        </section>
    {% endif %}
{% endblock %}
