{% extends 'base.html.twig' %}

{% block title %}{{ name }}{% endblock %}

{% block body %}
    {% if error %}
        <p class="muted">{{ error }}</p>
    {% endif %}

    {% if package %}
        <p class="muted pt-16">
            <a href="{{ path('marketplace_index') }}">&larr; {{ 'mautic.marketplace.detail.back'|trans }}</a>
        </p>
        {% set color = (
            package.type == 'mautic-plugin' ? '#4e5e9e' :
            package.type == 'mautic-theme' ? '#00b49d' :
            package.type == 'mautic-resource' ? '#fdb933' :
            '#ad9bd3'
        ) %}
        {% set type_label = package.type == 'mautic-plugin' ? 'mautic.marketplace.detail.type.plugin' :
            package.type == 'mautic-theme' ? 'mautic.marketplace.detail.type.theme' :
            package.type == 'mautic-resource' ? 'mautic.marketplace.detail.type.resource' :
            'mautic.marketplace.detail.type.other' %}
        {% set version_keys_sorted = package.versions ? (package.versions|keys|sort|reverse) : [] %}
        {% set latest_package_version = version_keys_sorted|length > 0 ? version_keys_sorted|first : null %}
        {% set latest_mautic_version = (latest_package_version and package.versions[latest_package_version].smv is defined) ? package.versions[latest_package_version].smv : null %}
        {% set leadspace_tags = [{ label: type_label|trans, color: 'gray' }] %}
        {% if latest_mautic_version %}
            {% set leadspace_tags = leadspace_tags|merge([{ label: 'mautic.marketplace.detail.latest_mautic_supported'|trans({ '%version%': latest_mautic_version }), color: 'blue' }]) %}
        {% endif %}
        {% include 'components/lead-space.html.twig' with {
            variant: 'short',
            heading: package.displayName ?: package.name,
            description: package.description,
            gradientStyleScheme: 'without-gradient',
            gradientStyleSchemeColor: color,
            tags: leadspace_tags,
        } %}
        <section class="detail-header mt-48">
            {% set contentBlockChild %}
            <div class="row justify-content-between">
                <div class="col-xs-12 col-sm-12 col-md-7">
                    {% set statCards = [
                        { eyebrow: 'mautic.marketplace.detail.stats.downloads', heading: package.downloads.total ?? 0 },
                        { eyebrow: 'mautic.marketplace.detail.stats.favers', heading: package.favers ?? 0 },
                        { eyebrow: 'mautic.marketplace.detail.stats.stars', heading: package.githubStars ?? 0 },
                        { eyebrow: 'mautic.marketplace.detail.stats.forks', heading: package.githubForks ?? 0 },
                        { eyebrow: 'mautic.marketplace.detail.stats.open_issues', heading: package.githubOpenIssues ?? 0 },
                        { eyebrow: 'mautic.marketplace.detail.stats.dependents', heading: package.dependents ?? 0 }
                    ] %}
            
                    <section>
                        {% include 'components/card-group.html.twig' with {
                            type: 'static',
                            gridMode: 'condensed',
                            cardsPerRow: 3,
                            cards: statCards
                        } %}
                    </section>
                </div>
                <div class="col-xs-12 col-md-4">
                    <div class="d-flex justify-content-between ai-center">
                        <span class="type-heading-02 ellipsis mb-12">{{ 'mautic.marketplace.detail.technical_details'|trans }}</span>
                        <i class="ri-box-2-line" aria-hidden="true"></i>
                    </div>
                    <hr class="mt-0 mb-24">
                    <!-- Last updated -->
                    <dt class="type-heading-01">{{ 'mautic.marketplace.detail.last_updated'|trans }}</dt>
                    {% if package.time %}
                    {% set updated_at = date(package.time) %}
                    <dd>
                        <time datetime="{{ updated_at|date('c') }}">{{ updated_at|relative_time_ago }}</time>
                        <i class="ri-information-2-line" aria-hidden="true" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ updated_at|date('Y-m-d') }}"></i>
                    </dd>
                    {% else %}
                    <dd class="text-helper">{{ 'mautic.marketplace.detail.unknown'|trans }}</dd>
                    {% endif %}

                    <!-- Language -->
                    <div class="mt-24">
                        <dt class="type-heading-01">{{ 'mautic.marketplace.detail.language'|trans }}</dt>
                        {% if package.language %}
                        <dd>{{ package.language }}</dd>
                        {% else %}
                        <dd class="text-helper">{{ 'mautic.marketplace.detail.unknown'|trans }}</dd>
                        {% endif %}

                    <!-- Maintainers -->
                    {% if package.maintainers %}
                    <dt class="type-heading-01 mt-24 mb-4">{{ 'mautic.marketplace.detail.maintainers'|trans }}</dt>
                    <dd>
                        {% set maintainer_tags = package.maintainers|map(m => ({ label: m.name ?? m, color: 'blue' })) %}
                        {% include 'components/tags.html.twig' with { tags: maintainer_tags } %}
                    </dd>
                    {% endif %}
                    </div>
                    
                    <!-- Repository -->
                    <dt class="type-heading-01 mt-24 mb-8">{{ 'mautic.marketplace.detail.repository'|trans }}</dt>
                    {% if package.repository or package.url %}
                        {% if package.repository %}
                        <dd>
                            <i class="ri-github-fill ri-lg" aria-hidden="true"></i>
                            <a href="{{ package.repository }}" target="_blank" rel="noopener">
                                {% set repoParts = package.repository|split('/') %}
                                {{ 'mautic.marketplace.detail.repository.github'|trans({
                                    '%repository%': repoParts[repoParts|length-2] ~ '/' ~ repoParts[repoParts|length-1]
                                }) }}
                            </a>
                        </dd>
                        {% endif %}
                        {% if package.url %}
                        <dd>
                            <i class="ri-box-2-fill ri-lg" aria-hidden="true"></i>
                                {% set pkgParts = package.url|split('/') %}
                                <a href="{{ package.url }}" target="_blank" rel="noopener">
                                    {{ 'mautic.marketplace.detail.repository.packagist'|trans({
                                        '%package%': pkgParts[pkgParts|length-2] ~ '/' ~ pkgParts[pkgParts|length-1]
                                    }) }}
                                </a>
                        </dd>
                        {% endif %}

                    {% else %}
                    <dd class="text-helper">{{ 'mautic.marketplace.detail.unknown'|trans }}</dd>
                    {% endif %}
                </div>
            </div>
            {% endset %}
            {% include 'components/content-block.html.twig' with {
                subheading: package.description ? package.description : null,
                childContainer: contentBlockChild
            } %}
        </section>

        <section class="section">
            <h2>{{ 'mautic.marketplace.detail.versions.heading'|trans }}</h2>
            {% if package.versions %}
                {% set versionKeys = package.versions|keys|sort|reverse %}
                {% set smvList = [] %}
                {% for version, data in package.versions %}
                    {% if data.smv is defined and data.smv is not empty and (data.smv not in smvList) %}
                        {% set smvList = smvList|merge([data.smv]) %}
                    {% endif %}
                {% endfor %}
                {% if smvList is not empty %}
                    <p class="muted">{{ 'mautic.marketplace.detail.versions.supported_mautic'|trans({ '%versions%': smvList|join(', ') }) }}</p>
                {% endif %}
                <div class="chip-list">
                    {% for version in versionKeys %}
                        <span class="chip">{{ version }}</span>
                    {% endfor %}
                </div>
                <p class="muted">{{ 'mautic.marketplace.detail.versions.count'|trans({ '%count%': versionKeys|length }) }}</p>
            {% else %}
                <p class="muted">{{ 'mautic.marketplace.detail.versions.empty'|trans }}</p>
            {% endif %}
        </section>

        <section class="section">
            <h2>{{ 'mautic.marketplace.detail.reviews.heading'|trans }}</h2>
            {% if package.reviews %}
                {% set hasReview = false %}
                {% for key, review in package.reviews %}
                    {% if review.rating is not null or review.review is not null %}
                        {% set hasReview = true %}
                        <div class="review-card">
                            <div><strong>{{ review.name ?? key }}</strong></div>
                            {% if review.rating is not null %}
                                <div class="review-card__meta">{{ 'mautic.marketplace.detail.reviews.rating'|trans({ '%rating%': review.rating }) }}</div>
                            {% endif %}
                            {% if review.review %}
                                <div>{{ review.review }}</div>
                            {% endif %}
                        </div>
                    {% endif %}
                {% endfor %}
                {% if not hasReview %}
                    <p class="muted">{{ 'mautic.marketplace.detail.reviews.empty'|trans }}</p>
                {% endif %}
            {% else %}
                <p class="muted">{{ 'mautic.marketplace.detail.reviews.empty'|trans }}</p>
            {% endif %}
        </section>

        <section class="section" id="marketplace-review-container"
            data-auth0-domain="{{ auth0_domain }}"
            data-auth0-client-id="{{ auth0_client_id }}"
            data-api-url="{{ path('review_api_submit', {package: name}) }}"
            data-package-name="{{ name }}">
            <h2>{{ 'mautic.marketplace.detail.review_form.heading'|trans }}</h2>

            <div id="auth-loading">
                <p class="muted">{{ 'mautic.marketplace.detail.review_form.loading_authentication'|trans }}</p>
            </div>

            <div id="auth-login" style="display:none">
                <button type="button" id="auth0-login-btn" class="bx--btn bx--btn--primary">
                    {{ 'mautic.marketplace.detail.review_form.login'|trans }}
                </button>
            </div>

            <div id="auth-form" style="display:none">
                <p class="muted">{{ 'mautic.marketplace.detail.review_form.logged_in_as'|trans }} <strong id="auth-user-name"></strong>
                    (<a href="#" id="auth0-logout-btn">{{ 'mautic.marketplace.detail.review_form.logout'|trans }}</a>)
                </p>
                <form id="review-form" class="review-form">
                    <div class="review-form__stars">
                        <label>{{ 'mautic.marketplace.detail.review_form.rating'|trans }}</label>
                        <div id="rating-stars" class="star-rating">
                            <span class="star-icon" data-rating="1">&#9733;</span>
                            <span class="star-icon" data-rating="2">&#9733;</span>
                            <span class="star-icon" data-rating="3">&#9733;</span>
                            <span class="star-icon" data-rating="4">&#9733;</span>
                            <span class="star-icon" data-rating="5">&#9733;</span>
                        </div>
                        <input type="hidden" id="rating" name="rating" value="0">
                    </div>
                    <div class="review-form__text">
                        <label for="review">{{ 'mautic.marketplace.detail.review_form.review'|trans }}</label>
                        <textarea id="review" name="review" class="bx--text-area" rows="4" placeholder="{{ 'mautic.marketplace.detail.review_form.review_placeholder'|trans }}"></textarea>
                    </div>
                    <button type="submit" id="submit-btn" class="bx--btn bx--btn--primary">{{ 'mautic.marketplace.detail.review_form.submit'|trans }}</button>
                </form>
            </div>

            <div id="review-error" class="alert alert--error" style="display:none"></div>
            <div id="review-success" class="alert alert--success" style="display:none"></div>
        </section>
    {% endif %}
{% endblock %}
