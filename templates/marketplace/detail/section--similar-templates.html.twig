<section class="mt-80">
    {% set similarTemplatesContent %}
    {% set cards = [] %}
    {% if similar_packages is defined and similar_packages is not null %}
    {% for item in similar_packages.items %}
        {% set ratingSummary = item.averageRating is not null
            ? item.averageRating|number_format(1)
            : 'marketplace.package.rating.none'
        %}
        {% set downloadsTotal = item.downloadsTotal is not null ? item.downloadsTotal|number_format(0, '.', ',') : '0' %}

        {% set customContent %}
        <div class="d-flex flex-wrap mt-16 gap-16">
            <div>
                <i class="ri-star-line" aria-hidden="true"></i>
                {{ ratingSummary }}
            </div>
            {% endset %}
            {% set card = {
                heading: item.displayName ?: item.name,
                copy: (
                (item.headline is defined and item.headline is not empty
                    ? item.headline
                    : (item.description is defined and item.description is not empty
                        ? item.description
                        : null
                    )
                ) is not null
                    ? (
                        (item.headline is defined and item.headline is not empty
                            ? item.headline
                            : item.description
                        )
                        |striptags
                        |replace({
                            '# ': '', '## ': '', '### ': '', '#### ': '', '##### ': '', '###### ': '',
                            '*': '', '**': '', '_': '', '__': '', '`': '', '~~': '',
                            '[': '', ']': '', '(': '', ')': '', '> ': '', '- ': '', '+ ': '', '!': '', '|': '', '>': ''
                        })
                        |u.truncate(100, '…')
                    )
                    : 'marketplace.package.description.none'
                ),
                image: { src: (item.bannerURL is defined and item.bannerURL is not null) ? item.bannerURL : '/assets/images/package_placeholder.jpg' },
                customContent: customContent,
                tags: [
                    {
                        label: item.type == 'mautic-plugin' ? 'marketplace.package.type.plugin' : item.type == 'mautic-theme' ? 'marketplace.package.type.theme' : 'marketplace.package.type.resource',
                        color: item.type == 'mautic-plugin' ? 'primary' : item.type == 'mautic-theme' ? 'secondary' : 'tertiary' }
                ]
            } %}
            {% set cards = cards|merge([card]) %}
        {% endfor %}

        {% include 'components/card-group.html.twig' with {
            cards: cards,
            type: 'default',
            cardsPerRow: 3,
            gridMode: 'condensed'
        } only %}
        {% endset %}
        {% set card = {
            heading: item.displayName ?: item.name,
            copy: item.description ?: 'marketplace.package.description.none',
            image: item.bannerURL is not null ? { src: item.bannerURL, alt: item.displayName ?: item.name } : null,
            href: path('marketplace_detail', { package: item.name }),
            customContent: customContent,
            tags: [
                { 
                    label: item.type == 'mautic-plugin' ? 'marketplace.package.type.plugin' : item.type == 'mautic-theme' ? 'marketplace.package.type.theme' : 'marketplace.package.type.resource', 
                    color: item.type == 'mautic-plugin' ? 'primary' : item.type == 'mautic-theme' ? 'secondary' : 'tertiary' }
            ]
        } %}
        {% set cards = cards|merge([card]) %}
    {% endfor %}
    {% endif %}

    {% include 'components/card-group.html.twig' with {
        cards: cards,
        type: 'default',
        cardsPerRow: 3,
        gridMode: 'condensed'
    } only %}
    {% endset %}

    {% include 'components/content-block.html.twig' with {
        heading: package.type == 'mautic-plugin' ? 'mautic.marketplace.detail.similar_templates.heading.plugin' : package.type == 'mautic-theme' ? 'mautic.marketplace.detail.similar_templates.heading.theme' : 'mautic.marketplace.detail.similar_templates.heading.resource',
        childContainer: similarTemplatesContent
    } %}
</section>
