<section class="my-64">

    {% set contentBlockChild %}

    <div class="d-flex fd-column row-gap-lg mt-32 mb-48">
        {% include 'components/pictogram.html.twig' with {'pictogram': 'install', 'size': 64, 'color': 'var(--icon-primary)'} %}
    </div>

{% if package.type == 'mautic-plugin' %}

{% elseif package.type == 'mautic-theme' %}

    {% set standardUploadInstructionsContent %}
<div class="row py-16">
    <div class="col-12">
        <div class="type-heading-01 p-16">{{ 'mautic.marketplace.detail.install_instructions.theme.standard_upload.heading'|trans }}</div>
    <ol class="list-group list-group-flush list-group-numbered list-group-marker list-group-marker--inverse install-instructions__steps layer-two">
        <li class="list-group-item">{{ 'mautic.marketplace.detail.install_instructions.theme.standard_upload.step.1'|trans|markdown_to_html }}</li>
        <li class="list-group-item">{{ 'mautic.marketplace.detail.install_instructions.theme.standard_upload.step.2'|trans({'%icon%': '<i class="ri-settings-5-line px-4"></i>'})|raw }}</li>
        <li class="list-group-item">{{ 'mautic.marketplace.detail.install_instructions.theme.standard_upload.step.3'|trans|markdown_to_html }}</li>
        <li class="list-group-item">{{ 'mautic.marketplace.detail.install_instructions.theme.standard_upload.step.4'|trans|markdown_to_html }}</li>
        <li class="list-group-item">{{ 'mautic.marketplace.detail.install_instructions.theme.standard_upload.step.5'|trans|markdown_to_html }}</li>
        <li class="list-group-item">{{ 'mautic.marketplace.detail.install_instructions.theme.standard_upload.step.6'|trans|markdown_to_html }}</li>
      </ol>
    </div>
    </div>
    {% endset %}

{% set manualUploadInstructionsContent %}
<div class="row py-16">
    <div class="col-12">
        <div class="type-heading-01 p-16">{{ 'mautic.marketplace.detail.install_instructions.theme.manual_upload.heading'|trans }}</div>
        <ol class="list-group list-group-flush list-group-numbered list-group-marker list-group-marker--inverse install-instructions__steps">
        <li class="list-group-item">{{ 'mautic.marketplace.detail.install_instructions.theme.manual_upload.step.1'|trans|markdown_to_html }}</li>
        <li class="list-group-item">{{ 'mautic.marketplace.detail.install_instructions.theme.manual_upload.step.2'|trans|markdown_to_html }}</li>
        <li class="list-group-item">{{ 'mautic.marketplace.detail.install_instructions.theme.manual_upload.step.3'|trans|markdown_to_html }}</li>
            <li class="list-group-item">{{ 'mautic.marketplace.detail.install_instructions.theme.manual_upload.step.4'|trans|markdown_to_html }}</li>
            <li class="list-group-item">{{ 'mautic.marketplace.detail.install_instructions.theme.manual_upload.step.5'|trans|markdown_to_html }}</li>
        </ol>
    </div>
</div>
</div>
{% endset %}

{% include 'components/tabs.html.twig' with {
    tabs: [
        { title: 'mautic.marketplace.detail.install_instructions.standard_upload', secondaryLabel: 'mautic.marketplace.detail.install_instructions.recommended', renderIcon: 'ri-upload-cloud-line', content: standardUploadInstructionsContent },
        { title: 'mautic.marketplace.detail.install_instructions.manual_upload', renderIcon: 'ri-tools-line', content: manualUploadInstructionsContent },
    ],
    variant: 'vertical',
} %}

{% elseif package.type == 'mautic-resource' %}

{% else %}

{% endif %}

{% endset %}


{% include 'components/content-block.html.twig' with {
    heading: 'mautic.marketplace.detail.install_instructions.heading',
    subheading: package.type == 'mautic-theme' ? 'mautic.marketplace.detail.install_instructions.theme.subheading' :
        package.type == 'mautic-plugin' ? 'mautic.marketplace.detail.install_instructions.plugin.subheading' :
        'mautic.marketplace.detail.install_instructions.resource.subheading',
    cta: {
        link: 'https://www.mautic.org',
        label: 'mautic.marketplace.detail.install_instructions.cta'
    },
    childContainer: contentBlockChild
} %}

</section>
