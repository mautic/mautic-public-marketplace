{% set reviews = package.reviews ?? [] %}
{% set displayReviews = [] %}
{% set totalRating = 0 %}
{% set ratingCount = 0 %}

{% for review in reviews %}
    {% set reviewRating = review.rating is defined ? review.rating : null %}
    {% if reviewRating is not null %}
        {% set totalRating = totalRating + reviewRating %}
        {% set ratingCount = ratingCount + 1 %}
    {% endif %}
{% endfor %}

{% set averageRating = ratingCount > 0 ? totalRating / ratingCount : null %}
{% set ratingSummary = averageRating is not null
    ? averageRating|number_format(1, '.', '')
    : '--'
%}

{% for review in reviews %}
    {% set reviewText = review.review ?? null %}
    {% set reviewAuthor = review.user ?? review.name ?? null %}
    {% set reviewRating = review.rating is defined ? review.rating : null %}

    {% if reviewRating is not null or reviewText %}
        {% set displayReviews = displayReviews|merge([{
            text: reviewText,
            author: reviewAuthor,
            rating: reviewRating,
        }]) %}
    {% endif %}
{% endfor %}

{% set visibleReviews = displayReviews|slice(0, 3) %}
{% set hasMoreReviews = displayReviews|length > 3 %}

{% set contentBlockChild %}
<hr class="mb-48 mx-md-n32">
    {% if displayReviews is not empty %}
        <div class="d-grid gap-8">
            {% for reviewData in visibleReviews %}
                {% set customContent %}
                    {% if reviewData.rating is not null %}
                        <div class="review-card__meta" aria-label="{{ 'mautic.marketplace.detail.reviews.rating'|trans({ '%rating%': reviewData.rating }) }}">
                            {% for i in 1..5 %}
                                <i class="ri-star-fill {{ i <= reviewData.rating ? 'text-primary' : 'text-disabled' }}" aria-hidden="true"></i>
                            {% endfor %}
                        </div>
                    {% endif %}
                {% endset %}
                <div {% if not loop.last %} class="mb-48"{% endif %}>
                {% include 'components/callout-quote.html.twig' with {
                    copy: reviewData.text|u.truncate(200, '…'),
                    sourceHeading: reviewData.author,
                    customContent: customContent,
                    hasBorder: (not loop.last) ? true : false,
                } only %}
                </div>
            {% endfor %}

            {% if hasMoreReviews %}
                {% include 'components/button.html.twig' with {
                    buttons: [{
                        label: 'mautic.marketplace.detail.reviews.show_all',
                        variant: 'link',
                        icon: 'ri-rectangle-line',
                        attributes: {
                            'data-bs-toggle': 'modal',
                            'data-bs-target': '#' ~ reviewsModalId,
                            'class': 'justify-content-start p-0'
                        }
                    }]
                } only %}
            {% endif %}
        </div>
    {% else %}
        <p class="text-placeholder">{{ 'mautic.marketplace.detail.reviews.empty'|trans }}</p>
    {% endif %}

    <section class="section mt-32" id="marketplace-review-container"
        data-auth0-domain="{{ auth0_domain }}"
        data-auth0-client-id="{{ auth0_client_id }}"
        data-api-url="{{ path('review_api_submit', {package: name}) }}"
        data-package-name="{{ name }}">
        <h2 class="type-heading-03 mb-16">{{ 'mautic.marketplace.detail.review_form.heading'|trans }}</h2>

        <div id="auth-loading">
            <p class="muted">{{ 'mautic.marketplace.detail.review_form.loading_authentication'|trans }}</p>
        </div>

        <div id="auth-login" style="display:none">
            {% include 'components/button.html.twig' with {
                buttons: [{
                    label: 'mautic.marketplace.detail.review_form.login',
                    variant: 'tertiary',
                    icon: 'ri-login-box-line',
                    attributes: {
                        id: 'auth0-login-btn',
                        type: 'button'
                    }
                }]
            } only %}
        </div>

        <div id="auth-form" style="display:none">
            {% include 'components/tags.html.twig' with {
                tags: [{
                    label: 'mautic.marketplace.detail.review_form.logout_with_username'|trans({
                        '%username%': '<strong id="auth-user-name"></strong>'
                    }),
                    type: 'read-only',
                    color: 'gray',
                    attributes: {
                        id: 'auth0-logout-btn',
                        href: '#'
                    }
                }]
            } only %}
            <form id="review-form" class="review-form needs-validation" novalidate>
                <div
                    class="review-form__stars mt-32 mb-24"
                    data-validation-group="true"
                    data-validation-name="rating"
                    data-validation-type="custom"
                    data-validation-label="{{ 'mautic.marketplace.detail.review_form.rating'|trans }}"
                    data-validation-rules="{{ ['ratingSelected']|json_encode|e('html_attr') }}"
                    data-validation-messages="{{ {
                        ratingSelected: 'mautic.marketplace.detail.review_form.rating_required'|trans
                    }|json_encode|e('html_attr') }}"
                    data-validation-feedback-id="rating-feedback"
                    data-validation-focus-selector="#rating-option-1"
                >
                    <label id="rating-label" class="review-form__label type-label-01 text-secondary mb-8">{{ 'mautic.marketplace.detail.review_form.rating'|trans }}</label>
                    <div id="rating-stars" class="review-form__star-rating ri-xl" role="radiogroup" aria-labelledby="rating-label" tabindex="-1">
                        {% for rating in 1..5 %}
                            <button
                                type="button"
                                class="review-form__star-button"
                                id="rating-option-{{ rating }}"
                                role="radio"
                                aria-checked="false"
                                aria-label="{{ 'mautic.marketplace.detail.reviews.rating'|trans({ '%rating%': rating }) }}"
                                data-rating-option
                                data-rating="{{ rating }}"
                                tabindex="{{ loop.first ? '0' : '-1' }}"
                            >
                                <i class="ri-star-fill review-form__star-icon" aria-hidden="true"></i>
                            </button>
                        {% endfor %}
                    </div>
                    <input type="hidden" id="rating" name="rating" value="0" class="review-form__rating-input">
                    <div id="rating-feedback" class="invalid-feedback" data-validation-feedback hidden aria-live="polite"></div>
                </div>

                {% include 'components/form-control.html.twig' with {
                    type: 'textarea',
                    name: 'review',
                    value: '',
                    label: 'mautic.marketplace.detail.review_form.review',
                    placeholder: 'mautic.marketplace.detail.review_form.review_placeholder',
                    help_text: 'mautic.marketplace.detail.review_form.review_help',
                    required: true,
                    rows: 4,
                    wrapper_class: 'review-form__text my-24',
                    validation: {
                        rules: ['notBlank', 'maxWords(200)'],
                        messages: {
                            notBlank: 'mautic.marketplace.detail.review_form.review_required'|trans,
                            maxWords: 'mautic.marketplace.detail.review_form.review_word_limit'|trans({'%count%': 200}),
                        }
                    }
                } only %}

                {% include 'components/button.html.twig' with {
                    buttons: [{
                        label: 'mautic.marketplace.detail.review_form.submit',
                        variant: 'tertiary',
                        size: 'sm',
                        icon: 'ri-arrow-right-line',
                        attributes: {
                            id: 'submit-btn',
                            type: 'submit'
                        }
                    }]
                } only %}
            </form>
        </div>

        <div id="review-error" class="alert alert--error" style="display:none"></div>
        <div id="review-success" class="alert alert--success" style="display:none"></div>
    </section>
{% endset %}

{% if hasMoreReviews %}
    {% set reviewsModalBody %}
        <div class="row justify-content-center gap-32 my-24">
            <div class="col-12 col-md-3">
                {% include 'marketplace/detail/module--review-summary.html.twig' %}
            </div>
            <div class="col-12 col-md-6">
            {% for reviewData in displayReviews %}
                  <div class="review__wrapper">
                      <div class="d-flex justify-content-between align-items-center pb-8">
                          {% if reviewData.rating is not null %}
                          <div class="review-card__meta" aria-label="{{ 'mautic.marketplace.detail.reviews.rating'|trans({ '%rating%': reviewData.rating }) }}">
                              {% for i in 1..5 %}
                              <i class="ri-star-fill {{ i <= reviewData.rating ? 'text-primary' : 'text-disabled' }}" aria-hidden="true"></i>
                              {% endfor %}
                            </div>
                            {% endif %}
                            {% if reviewData.author is not empty %}
                              <div class="type-legal-01 text-disabled">{{ reviewData.author }}</div>
                            {% endif %}
                      </div>

                    <div class="review__copy pb-8 mb-48 type-body-compact-02 text-break">{{ reviewData.text }}</div>
                  </div>
        {% endfor %}
    </div>
        </div>
    {% endset %}

    {% include 'components/modal.html.twig' with {
        id: reviewsModalId,
        title: 'mautic.marketplace.detail.reviews.heading'|trans,
        centered: true,
        fullscreen: true,
        scrollable: true,
        size: 'lg',
        body: reviewsModalBody
    } only %}
{% endif %}

<section class="section my-64">
    {% include 'components/content-block.html.twig' with {
        heading: 'mautic.marketplace.detail.reviews.heading',
        childContainer: contentBlockChild,
        hasBorder: true
    } only %}
</section>
