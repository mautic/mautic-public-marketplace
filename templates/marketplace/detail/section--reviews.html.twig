{% set displayReviews = display_reviews|default([]) %}
{% set visibleReviews = displayReviews|slice(0, 3) %}
{% set hasMoreReviews = displayReviews|length > 3 %}
{% set ratingSummary = average_rating is not null
    ? average_rating|number_format(1, '.', '')
    : 'marketplace.package.rating.none'|trans
%}

{% set contentBlockChild %}
<hr class="mb-48 mx-md-n32">
    {% if displayReviews is not empty %}
        <div class="d-grid gap-8">
            {% for reviewData in visibleReviews %}
                {% set customContent %}
                    {% if reviewData.rating is not null %}
                        <div class="review-card__meta" aria-label="{{ 'mautic.marketplace.detail.reviews.rating'|trans({ '%rating%': reviewData.rating }) }}">
                            {% for i in 1..5 %}
                                <i class="ri-star-fill {{ i <= reviewData.rating ? 'text-primary' : 'text-disabled' }}" aria-hidden="true"></i>
                            {% endfor %}
                        </div>
                    {% endif %}
                {% endset %}
                <div {% if not loop.last %} class="mb-48"{% endif %}>
                {% include 'components/callout-quote.html.twig' with {
                    copy: reviewData.text|u.truncate(200, '…'),
                    sourceHeading: reviewData.author,
                    customContent: customContent,
                    hasBorder: (not loop.last) ? true : false,
                } only %}
                </div>
            {% endfor %}

            {% if hasMoreReviews %}
                {% include 'components/button.html.twig' with {
                    buttons: [{
                        label: 'mautic.marketplace.detail.reviews.show_all',
                        variant: 'link',
                        icon: 'ri-rectangle-line',
                        attributes: {
                            'data-bs-toggle': 'modal',
                            'data-bs-target': '#' ~ reviewsModalId,
                            'class': 'justify-content-start p-0'
                        }
                    }]
                } only %}
            {% endif %}
        </div>
    {% else %}
        <p class="text-placeholder">{{ 'mautic.marketplace.detail.reviews.empty'|trans }}</p>
    {% endif %}

    <section class="section mt-32" id="marketplace-review-container">
        <h2 class="type-heading-03 mb-16">{{ 'mautic.marketplace.detail.review_form.heading'|trans }}</h2>

        {% if app.user %}
            <p class="muted">{{ 'mautic.marketplace.detail.review_form.logged_in_as'|trans }} <strong>{{ app.user.name ?? app.user.email ?? 'Anonymous' }}</strong>
                (<a href="{{ path('auth_logout') }}">{{ 'mautic.marketplace.detail.review_form.logout'|trans }}</a>)
            </p>
            {% if review_errors.form is defined %}
                <div class="alert alert--error mb-16">{{ review_errors.form }}</div>
            {% endif %}
            <form id="review-form" class="review-form" method="post" action="{{ path('review_submit', { package: name }) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('review_' ~ name) }}">
                <div class="review-form__stars">
                    <label>{{ 'mautic.marketplace.detail.review_form.rating'|trans }}</label>
                    <div id="rating-stars" class="star-rating">
                        {% for ratingValue in 1..5 %}
                            <button type="button"
                                class="star-icon{{ review_form.rating|default('0') == ratingValue ? ' star-active' : '' }}"
                                data-rating="{{ ratingValue }}"
                                aria-label="{{ 'mautic.marketplace.detail.reviews.rating'|trans({ '%rating%': ratingValue }) }}">
                                &#9733;
                            </button>
                        {% endfor %}
                    </div>
                    <input type="hidden" id="rating" name="rating" value="{{ review_form.rating|default('0') }}">
                </div>
                <div class="review-form__text">
                    <label for="review">{{ 'mautic.marketplace.detail.review_form.review'|trans }}</label>
                    <textarea id="review" name="review" class="bx--text-area" rows="4" placeholder="{{ 'mautic.marketplace.detail.review_form.review_placeholder'|trans }}">{{ review_form.review|default('') }}</textarea>
                </div>
                <button type="submit" id="submit-btn" class="bx--btn bx--btn--primary">{{ 'mautic.marketplace.detail.review_form.submit'|trans }}</button>
            </form>
        {% else %}
            <a class="bx--btn bx--btn--primary" href="{{ path('auth_login', { returnTo: app.request.requestUri }) }}">
                {{ 'mautic.marketplace.detail.review_form.login'|trans }}
            </a>
        {% endif %}
    </section>
{% endset %}

{% if hasMoreReviews %}
    {% set reviewsModalBody %}
        <div class="row justify-content-center gap-32 my-24">
            <div class="col-12 col-md-3">
                {% include 'marketplace/detail/module--review-summary.html.twig' %}
            </div>
            <div class="col-12 col-md-6">
            {% for reviewData in displayReviews %}
                  <div class="review__wrapper">
                      <div class="d-flex justify-content-between align-items-center pb-8">
                          {% if reviewData.rating is not null %}
                          <div class="review-card__meta" aria-label="{{ 'mautic.marketplace.detail.reviews.rating'|trans({ '%rating%': reviewData.rating }) }}">
                              {% for i in 1..5 %}
                              <i class="ri-star-fill {{ i <= reviewData.rating ? 'text-primary' : 'text-disabled' }}" aria-hidden="true"></i>
                              {% endfor %}
                            </div>
                            {% endif %}
                            {% if reviewData.author is not empty %}
                              <div class="type-legal-01 text-disabled">{{ reviewData.author }}</div>
                            {% endif %}
                      </div>

                    <div class="review__copy pb-8 mb-48 type-body-compact-02 text-break">{{ reviewData.text }}</div>
                  </div>
        {% endfor %}
    </div>
        </div>
    {% endset %}

    {% include 'components/modal.html.twig' with {
        id: reviewsModalId,
        title: 'mautic.marketplace.detail.reviews.heading'|trans,
        centered: true,
        fullscreen: true,
        scrollable: true,
        size: 'lg',
        body: reviewsModalBody
    } only %}
{% endif %}

<section class="section my-64">
    {% include 'components/content-block.html.twig' with {
        heading: 'mautic.marketplace.detail.reviews.heading',
        childContainer: contentBlockChild,
        hasBorder: true
    } only %}
</section>
