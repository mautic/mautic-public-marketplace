{% extends 'base.html.twig' %}

{% block title %}{{ 'mautic.marketplace.title'|trans }}{% endblock %}

{% block body %}
    {% set current = app.request.query.all %}
    {% set orderby = filters.orderby %}
    {% set orderdir = filters.orderdir %}
    {% set marketplace_total_pages = 1 %}
    {% if result and result.total is not null and result.limit > 0 %}
        {% set marketplace_total_pages = max(1, (result.total / result.limit)|round(0, 'ceil')) %}
    {% endif %}

    {% include 'components/lead-space.html.twig' with {
        variant: 'short',
        heading: 'mautic.marketplace.browse.leadspace.heading',
        gradientStyleScheme: 'without-gradient',
        gradientStyleSchemeColor: '#f1edea',
    } %}

    {% if error %}
        <p class="muted">{{ error }}</p>
    {% endif %}

    <form class="mt-4" method="get" id="marketplace-filters" data-autosubmit="true" data-turbo-frame="package-results">
        <div class="row mt-12 mb-32">
            <div class="col-12 col-lg-3 order-2 order-lg-1 mt-24 mt-lg-0">
                {% set allTypesCount = (type_counts['mautic-plugin'] ?? 0) + (type_counts['mautic-theme'] ?? 0) + (type_counts['mautic-resource'] ?? 0) %}
                {% set compatibilityFilterItems = [] %}
                {% for version in mautic_versions %}
                    {% set compatibilityFilterItems = compatibilityFilterItems|merge([{
                        label: mautic_version_labels[version] ?? version,
                        value: version,
                        checked: version in (filters.mautic ?? [])
                    }]) %}
                {% endfor %}
                {% include 'components/filter-panel.html.twig' with {
                    heading: 'marketplace.index.filters.heading',
                    filterCutoff: 5,
                    filterGroups: [
                        {
                            title: 'marketplace.index.filters.type.label',
                            filterGroupItemsType: 'select',
                            filterGroupItems: [
                                { label: 'marketplace.index.filters.type.all_count'|trans({'%count%': allTypesCount}), value: '', checked: (filters.type ?? '') == '' },
                                { label: 'marketplace.index.filters.type.plugin_count'|trans({'%count%': (type_counts['mautic-plugin'] ?? 0)}), value: 'mautic-plugin', checked: (filters.type ?? '') == 'mautic-plugin' },
                                { label: 'marketplace.index.filters.type.theme_count'|trans({'%count%': (type_counts['mautic-theme'] ?? 0)}), value: 'mautic-theme', checked: (filters.type ?? '') == 'mautic-theme' },
                                { label: 'marketplace.index.filters.type.resource_count'|trans({'%count%': (type_counts['mautic-resource'] ?? 0)}), value: 'mautic-resource', checked: (filters.type ?? '') == 'mautic-resource' }
                            ]
                        },
                        {
                            title: 'marketplace.index.filters.compatibility.label',
                            name: 'mautic',
                            filterGroupItemsType: 'checkbox',
                            filterGroupItems: compatibilityFilterItems
                        },
                        {
                            title: 'marketplace.index.filters.date_range.label',
                            filterGroupItemsType: 'select',
                            filterGroupItems: [
                                { label: 'marketplace.index.filters.date_range.7d', value: '7d', checked: (filters.date_range ?? '') == '7d' },
                                { label: 'marketplace.index.filters.date_range.30d', value: '30d', checked: (filters.date_range ?? '') == '30d' },
                                { label: 'marketplace.index.filters.date_range.90d', value: '90d', checked: (filters.date_range ?? '') == '90d' },
                                { label: 'marketplace.index.filters.date_range.365d', value: '365d', checked: (filters.date_range ?? '') == '365d' }
                            ]
                        }
                    ]
                } only %}
                <input type="hidden" name="orderby" value="{{ orderby }}">
                <input type="hidden" name="orderdir" value="{{ orderdir }}">
                {% if marketplace_total_pages <= 1 %}
                <input type="hidden" name="limit" value="{{ filters.limit }}">
                <input type="hidden" name="offset" value="{{ filters.offset }}">
                {% endif %}
            </div>
            <div class="col-12 col-lg-9 order-1 order-lg-2">
                <div class="row justify-content-end">
                    <div class="col-md-9">
                        {% include 'components/floating-label.html.twig' with {
                            id: 'query',
                            name: 'query',
                            value: filters.query ?? '',
                            label: 'marketplace.index.filters.search.placeholder',
                            wrapper_class: 'mb-16',
                            icon: 'ri-search-line ri-lg'
                        } only %}
                    </div>
                    <div class="col-md-3">
                        {% include 'components/floating-label.html.twig' with {
                            component: 'select',
                            name: 'popularity',
                            value: filters.popularity ?? '',
                            label: 'marketplace.index.filters.popularity.placeholder',
                            options: [
                                { value: 'most_popular', label: 'marketplace.index.filters.popularity.most_popular' },
                                { value: 'top_rated', label: 'marketplace.index.filters.popularity.top_rated' },
                                { value: 'newest', label: 'marketplace.index.filters.popularity.newest' },
                                { value: 'rising', label: 'marketplace.index.filters.popularity.rising' }
                            ]
                        } only %}
                    </div>
                </div>

                <turbo-frame id="package-results" data-turbo-action="advance">
    {% if result and result.items is not empty %}
    {% set cards = [] %}
    {% for item in result.items %}
        {% set ratingSummary = item.averageRating is not null
            ? item.averageRating|number_format(1)
            : 'marketplace.package.rating.none'
        %}
        {% set reviewCount = item.totalReviews ?? 0 %}
        {% set downloadsTotal = item.downloadsTotal >= 1000 
            ? (item.downloadsTotal / 1000)|round ~ 'k' 
            : (item.downloadsTotal ?? 0) %}
        {% set reviewsTooltipKey = reviewCount == 1
            ? 'marketplace.package.review.tooltip'
            : 'marketplace.package.reviews.tooltip'
        %}
        {% set customContent %}
        <div class="d-flex flex-wrap mt-16 gap-16">
            <div class="d-flex align-items-center gap-2">
                <i class="ri-star-line" aria-hidden="true"></i>
                {{ ratingSummary }}
            </div>
            <div class="d-flex align-items-center gap-2">
                <i class="ri-download-line" aria-hidden="true"></i>
                {{ downloadsTotal }}
            </div>
        </div>
        {% endset %}
        {% set card = {
            heading: item.displayName ?: item.name,
            copy: (
                (item.headline is defined and item.headline is not empty
                    ? item.headline
                    : (item.description is defined and item.description is not empty
                        ? item.description
                        : null
                    )
                ) is not null
                    ? (
                        (item.headline is defined and item.headline is not empty
                            ? item.headline
                            : item.description
                        )
                        |striptags
                        |replace({
                            '# ': '', '## ': '', '### ': '', '#### ': '', '##### ': '', '###### ': '',
                            '*': '', '**': '', '_': '', '__': '', '`': '', '~~': '',
                            '[': '', ']': '', '(': '', ')': '', '> ': '', '- ': '', '+ ': '', '!': '', '|': '', '>': ''
                        })
                        |u.truncate(100, '…')
                    )
                    : 'marketplace.package.description.none'
            ),
            image: item.bannerURL is defined and item.bannerURL is not null ? { src: item.bannerURL, alt: item.displayName ?: item.name } : null,
            href: path('marketplace_detail', { package: item.name }),
            attributes: {'data-turbo-frame': '_top'},
            customContent: customContent,
            tags: [
                { 
                    label: item.type == 'mautic-plugin' ? 'marketplace.package.type.plugin' : item.type == 'mautic-theme' ? 'marketplace.package.type.theme' : 'marketplace.package.type.resource', 
                    color: item.type == 'mautic-plugin' ? 'primary' : item.type == 'mautic-theme' ? 'secondary' : 'tertiary' }
            ]
        } %}
        {% set cards = cards|merge([card]) %}
    {% endfor %}

    {% include 'components/card-group.html.twig' with {
        cards: cards,
        type: 'default',
        cardsPerRow: 3,
        gridMode: 'narrow'
    } only %}
        {% if result.total is not null %}
            {% set marketplace_list_page = result.limit > 0 ? (result.offset / result.limit)|round(0, 'floor') + 1 : 1 %}
            {% set marketplace_prev_offset = result.offset - result.limit %}
            {% set marketplace_next_offset = result.offset + result.limit %}
            <hr>
            {% include 'components/pagination-nav.html.twig' with {
                id: 'marketplace-nav-pagination',
                page: marketplace_list_page,
                pageSize: result.limit,
                route: 'marketplace_index',
                leadingPages: 3,
                routeParameters: current,
                size: 'sm',
                totalItems: result.total
            } only %}
        {% endif %}
    {% else %}
            <div class="empty-state muted">{{ 'marketplace.index.empty'|trans }}</div>
    {% endif %}
                </turbo-frame>
            </div>
        </div>
    </form>

{% endblock %}
