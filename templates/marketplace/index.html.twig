{% extends 'base.html.twig' %}

{% block title %}Marketplace{% endblock %}

{% block body %}
    {% set current = app.request.query.all %}
    {% set orderby = filters.orderby %}
    {% set orderdir = filters.orderdir %}

    <h1 class="page-title">Marketplace</h1>
    <p class="muted">Browse community packages compatible with Mautic.</p>

    {% if error %}
        <p class="muted">{{ error }}</p>
    {% endif %}

    <form class="toolbar" method="get" id="marketplace-filters" data-autosubmit="true">
        <div class="bx--form-item">
            <label class="bx--label" for="query">{{ 'marketplace.index.filters.search.label'|trans }}</label>
            <input class="bx--text-input" id="query" name="query" type="text" value="{{ filters.query ?? '' }}" placeholder="{{ 'marketplace.index.filters.search.placeholder'|trans }}">
        </div>
        <div class="bx--form-item">
            <label class="bx--label" for="type">{{ 'marketplace.index.filters.type.label'|trans }}</label>
            <div class="bx--select">
                <select class="bx--select-input" id="type" name="type">
                    <option value="">{{ 'marketplace.index.filters.type.all'|trans }}</option>
                    <option value="mautic-plugin" {% if filters.type == 'mautic-plugin' %}selected{% endif %}>{{ 'marketplace.package.type.plugin'|trans }}</option>
                    <option value="mautic-theme" {% if filters.type == 'mautic-theme' %}selected{% endif %}>{{ 'marketplace.package.type.theme'|trans }}</option>
                    <option value="mautic-resource" {% if filters.type == 'mautic-resource' %}selected{% endif %}>{{ 'marketplace.package.type.resource'|trans }}</option>
                </select>
                <svg class="bx--select__arrow" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M8 11L3 6h10L8 11z" fill="currentColor"></path>
                </svg>
            </div>
        </div>
        <div class="bx--form-item">
            <label class="bx--label" for="mautic">{{ 'marketplace.index.filters.mautic.label'|trans }}</label>
            <input class="bx--text-input" id="mautic" name="mautic" type="text" value="{{ filters.mautic ?? '' }}" placeholder="{{ 'marketplace.index.filters.mautic.placeholder'|trans }}">
        </div>
        <div class="bx--form-item">
            <label class="bx--label" for="popularity">Popularity</label>
            <div class="bx--select">
                <select class="bx--select-input" id="popularity" name="popularity">
                    <option value="">Default</option>
                    <option value="most_popular" {% if filters.popularity == 'most_popular' %}selected{% endif %}>Most popular</option>
                    <option value="top_rated" {% if filters.popularity == 'top_rated' %}selected{% endif %}>Top rated</option>
                    <option value="newest" {% if filters.popularity == 'newest' %}selected{% endif %}>Newest</option>
                    <option value="rising" {% if filters.popularity == 'rising' %}selected{% endif %}>Rising</option>
                </select>
                <svg class="bx--select__arrow" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M8 11L3 6h10L8 11z" fill="currentColor"></path>
                </svg>
            </div>
        </div>
        <div class="bx--form-item">
            <label class="bx--label" for="date_range">Upload date</label>
            <div class="bx--select">
                <select class="bx--select-input" id="date_range" name="date_range">
                    <option value="">All time</option>
                    <option value="7d" {% if filters.date_range == '7d' %}selected{% endif %}>Last 7 days</option>
                    <option value="30d" {% if filters.date_range == '30d' %}selected{% endif %}>Last 30 days</option>
                    <option value="90d" {% if filters.date_range == '90d' %}selected{% endif %}>Last 90 days</option>
                    <option value="365d" {% if filters.date_range == '365d' %}selected{% endif %}>Last year</option>
                </select>
                <svg class="bx--select__arrow" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M8 11L3 6h10L8 11z" fill="currentColor"></path>
                </svg>
            </div>
        </div>
        <input type="hidden" name="orderby" value="{{ orderby }}">
        <input type="hidden" name="orderdir" value="{{ orderdir }}">
        <input type="hidden" name="limit" value="{{ filters.limit }}">
    </form>

    {% if result and result.items is not empty %}
        {% set cards = [] %}
        {% for item in result.items %}
            {% set typeLabel = item.type == 'mautic-theme'
                ? 'marketplace.package.type.theme'
                : (item.type == 'mautic-resource' ? 'marketplace.package.type.resource' : 'marketplace.package.type.plugin')
            %}
            {% set ratingSummary = item.averageRating is not null
                ? item.averageRating|number_format(1)
                : 'marketplace.package.rating.none'
            %}
            {% set reviewCount = item.totalReviews ?? 0 %}
            {% set downloadsTotal = item.downloadsTotal is not null ? item.downloadsTotal|number_format(0, '.', ',') : '0' %}
            {% set reviewsTooltipKey = reviewCount == 1
                ? 'marketplace.package.review.tooltip'
                : 'marketplace.package.reviews.tooltip'
            %}
            {% set card = {
                heading: item.displayName ?: item.name,
                copy: item.description ?: 'marketplace.package.description.none',
                eyebrow: typeLabel,
                href: path('marketplace_detail', { package: item.name }),
                tags: [
                    { label: downloadsTotal, icon: 'ri-download-line', color: 'brand', attributes: { title: 'marketplace.package.downloads.tooltip'|trans({'%count%': downloadsTotal}), 'data-bs-toggle': 'tooltip', 'data-bs-placement': 'top' } },
                    { label: ratingSummary, icon: 'ri-star-line', color: 'brand', attributes: { title: reviewsTooltipKey|trans({'%count%': reviewCount}), 'data-bs-toggle': 'tooltip', 'data-bs-placement': 'top' } }
                ]
            } %}
            {% set cards = cards|merge([card]) %}
        {% endfor %}

        {% include 'components/card-group.html.twig' with {
            cards: cards,
            type: 'default',
            cardsPerRow: 4,
            gridMode: 'narrow'
        } only %}
        {% if result.total is not null %}
            {% set totalPages = (result.total / result.limit)|round(0, 'ceil') %}
            {% if totalPages > 1 %}
                {% set currentPage = (result.offset / result.limit)|round(0, 'floor') + 1 %}
                <nav class="pagination" aria-label="{{ 'marketplace.index.pagination.aria'|trans }}">
                    {% set prevOffset = result.offset - result.limit %}
                    {% set nextOffset = result.offset + result.limit %}
                    <div class="pagination__controls">
                        {% if prevOffset >= 0 %}
                            <a class="bx--btn bx--btn--tertiary bx--btn--sm"
                               href="{{ path('marketplace_index', current|merge({'offset': prevOffset})) }}">{{ 'marketplace.index.pagination.previous'|trans }}</a>
                        {% else %}
                            <span class="bx--btn bx--btn--tertiary bx--btn--sm bx--btn--disabled">{{ 'marketplace.index.pagination.previous'|trans }}</span>
                        {% endif %}

                        {% if nextOffset < result.total %}
                            <a class="bx--btn bx--btn--tertiary bx--btn--sm"
                               href="{{ path('marketplace_index', current|merge({'offset': nextOffset})) }}">{{ 'marketplace.index.pagination.next'|trans }}</a>
                        {% else %}
                            <span class="bx--btn bx--btn--tertiary bx--btn--sm bx--btn--disabled">{{ 'marketplace.index.pagination.next'|trans }}</span>
                        {% endif %}
                    </div>
                    <div class="pagination__meta muted">
                        {{ 'marketplace.index.pagination.meta'|trans({'%page%': currentPage, '%pages%': totalPages, '%results%': result.total}) }}
                    </div>
                </nav>
            {% endif %}
        {% endif %}
    {% else %}
        <div class="empty-state muted">{{ 'marketplace.index.empty'|trans }}</div>
    {% endif %}
{% endblock %}
