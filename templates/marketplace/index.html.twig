{% extends 'base.html.twig' %}

{% block title %}Marketplace{% endblock %}

{% block body %}
    {% set current = app.request.query.all %}
    {% set orderby = filters.orderby %}
    {% set orderdir = filters.orderdir %}

    {% include 'components/lead-space.html.twig' with {
        variant: 'short',
        heading: 'mautic.marketplace.leadspace.heading',
        gradientStyleScheme: 'without-gradient',
        gradientStyleSchemeColor: '#f1edea',
    } %}

    {% if error %}
        <p class="muted">{{ error }}</p>
    {% endif %}

    <form class="mt-4" method="get" id="marketplace-filters" data-autosubmit="true">
        <div class="row">
            <div class="col-xs-12">
                <div class="form-group mb-16">
                    <input class="form-control" id="query" name="query" type="text" value="{{ filters.query ?? '' }}" placeholder="Search packages or maintainers">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-xs-12 col-lg-3">
                <div class="form-group">
                    <label for="type">Type</label>
                    <select class="form-control" id="type" name="type">
                        <option value="">All types</option>
                        <option value="mautic-plugin" {% if filters.type == 'mautic-plugin' %}selected{% endif %}>Plugin</option>
                        <option value="mautic-theme" {% if filters.type == 'mautic-theme' %}selected{% endif %}>Theme</option>
                        <option value="mautic-resource" {% if filters.type == 'mautic-resource' %}selected{% endif %}>Resource</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="mautic">Mautic version</label>
                    <input class="form-control" id="mautic" name="mautic" type="text" value="{{ filters.mautic ?? '' }}" placeholder="e.g. ^5.0">
                </div>
                <div class="form-group">
                    <label for="popularity">Popularity</label>
                    <select class="form-control" id="popularity" name="popularity">
                        <option value="">Default</option>
                        <option value="most_popular" {% if filters.popularity == 'most_popular' %}selected{% endif %}>Most popular</option>
                        <option value="top_rated" {% if filters.popularity == 'top_rated' %}selected{% endif %}>Top rated</option>
                        <option value="newest" {% if filters.popularity == 'newest' %}selected{% endif %}>Newest</option>
                        <option value="rising" {% if filters.popularity == 'rising' %}selected{% endif %}>Rising</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="date_range">Upload date</label>
                    <select class="form-control" id="date_range" name="date_range">
                        <option value="">All time</option>
                        <option value="7d" {% if filters.date_range == '7d' %}selected{% endif %}>Last 7 days</option>
                        <option value="30d" {% if filters.date_range == '30d' %}selected{% endif %}>Last 30 days</option>
                        <option value="90d" {% if filters.date_range == '90d' %}selected{% endif %}>Last 90 days</option>
                        <option value="365d" {% if filters.date_range == '365d' %}selected{% endif %}>Last year</option>
                    </select>
                </div>
                <input type="hidden" name="orderby" value="{{ orderby }}">
                <input type="hidden" name="orderdir" value="{{ orderdir }}">
                <input type="hidden" name="limit" value="{{ filters.limit }}">
            </div>
            <div class="col-xs-12 col-lg-9">
    {% if result and result.items is not empty %}
        <div class="table-wrap">
            <div class="table-scroll">
                <table class="table table-hover table-condensed">
                    <thead>
                        <tr>
                            {% set nameDir = (orderby == 'name' and orderdir == 'asc') ? 'desc' : 'asc' %}
                            <th>
                                <a class="sort-link" href="{{ path('marketplace_index', current|merge({'orderby': 'name', 'orderdir': nameDir})) }}">
                                    Name
                                    {% if orderby == 'name' %}
                                        <span class="sort-indicator">{{ orderdir == 'asc' ? '▲' : '▼' }}</span>
                                    {% endif %}
                                </a>
                            </th>
                            <th>Type</th>
                            {% set downloadsDir = (orderby == 'downloads' and orderdir == 'asc') ? 'desc' : 'asc' %}
                            <th>
                                <a class="sort-link" href="{{ path('marketplace_index', current|merge({'orderby': 'downloads', 'orderdir': downloadsDir})) }}">
                                    Downloads
                                    {% if orderby == 'downloads' %}
                                        <span class="sort-indicator">{{ orderdir == 'asc' ? '▲' : '▼' }}</span>
                                    {% endif %}
                                </a>
                            </th>
                            {% set ratingDir = (orderby == 'rating' and orderdir == 'asc') ? 'desc' : 'asc' %}
                            <th>
                                <a class="sort-link" href="{{ path('marketplace_index', current|merge({'orderby': 'rating', 'orderdir': ratingDir})) }}">
                                    Rating
                                    {% if orderby == 'rating' %}
                                        <span class="sort-indicator">{{ orderdir == 'asc' ? '▲' : '▼' }}</span>
                                    {% endif %}
                                </a>
                            </th>
                            <th>Reviews</th>
                            <th>Updated</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in result.items %}
                            <tr>
                                <td>
                                    <div>
                                        <a href="{{ path('marketplace_detail', { package: item.name }) }}">
                                            {{ item.displayName ?: item.name }}
                                        </a>
                                    </div>
                                    {% if item.description %}
                                        <div class="muted">{{ item.description }}</div>
                                    {% endif %}
                                </td>
                                <td>{{ item.type ?? '—' }}</td>
                                <td>{{ item.downloadsTotal is not null ? item.downloadsTotal|number_format(0, '.', ',') : 0 }}</td>
                                <td>{{ item.averageRating is not null ? item.averageRating|number_format(1) : '—' }}</td>
                                <td>{{ item.totalReviews ?? 0 }}</td>
                                <td>
                                    {% if item.updatedAt %}
                                        {{ item.updatedAt|date('Y-m-d') }}
                                    {% else %}
                                        —
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        {% if result.total is not null %}
            {% set totalPages = (result.total / result.limit)|round(0, 'ceil') %}
            {% if totalPages > 1 %}
                {% set currentPage = (result.offset / result.limit)|round(0, 'floor') + 1 %}
                <nav class="pagination" aria-label="Pagination">
                    {% set prevOffset = result.offset - result.limit %}
                    {% set nextOffset = result.offset + result.limit %}
                    <div class="pagination__controls">
                        {% if prevOffset >= 0 %}
                            <a class="btn btn-default"
                               href="{{ path('marketplace_index', current|merge({'offset': prevOffset})) }}">Previous</a>
                        {% else %}
                            <span class="btn btn-default disabled">Previous</span>
                        {% endif %}

                        {% if nextOffset < result.total %}
                            <a class="btn btn-default"
                               href="{{ path('marketplace_index', current|merge({'offset': nextOffset})) }}">Next</a>
                        {% else %}
                            <span class="btn btn-default disabled">Next</span>
                        {% endif %}
                    </div>
                    <div class="pagination__meta muted">
                        Page {{ currentPage }} of {{ totalPages }} • {{ result.total }} results
                    </div>
                </nav>
            {% endif %}
        {% endif %}
    {% else %}
            <div class="empty-state muted">No packages found.</div>
    {% endif %}
            </div>
        </div>
    </form>

{% endblock %}
