        variant: 'short',
        heading: 'mautic.marketplace.upload.package.heading',
        description: 'mautic.marketplace.upload.package.description',
        gradientStyleScheme: 'without-gradient',
        gradientStyleSchemeColor: '#f1edea',
    } %}

    <div class="row mt-32">
        <div class="col-12 col-lg-8 offset-lg-2">
            <div id="package-upload-form-placeholder" class="p-32 border rounded text-center text-helper">
