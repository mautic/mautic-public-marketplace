{% extends 'base.html.twig' %}

{% block title %}
    {{ 'mautic.marketplace.upload.package.title'|trans }}
{% endblock %}

{% block body %}
    <div class="container-fluid px-32 mt-48">
        <div class="row pt-32">
            <div class="col-12 col-lg-6">
                <h1 class="type-heading-05 mb-16">
                    {{ 'mautic.marketplace.upload.package.heading'|trans }}
                </h1>
                <p class="type-body-02 text-secondary">
                    {{ 'mautic.marketplace.upload.package.description'|trans }}
                </p>
            </div>
        </div>
    </div>
    <hr class="mb-0" />

    {# All four steps render up front; upload-wizard.js shows one at a time and
       keeps the chosen ZIP in memory so it survives navigation between steps. #}

    <!-- Step 1 -->
    <form id="package-upload-form" data-wizard-step="1" class="needs-validation" novalidate>
        <div class="container-fluid">
            <div class="row">
                <div class="col-12 col-lg-3 p-32">
                    {% include 'components/progress-indicator.html.twig' with {
                        vertical: true,
                        steps: [
                            { label: 'mautic.marketplace.upload.package.step.1', status: 'current' },
                            { label: 'mautic.marketplace.upload.package.step.2', status: 'incomplete' },
                            { label: 'mautic.marketplace.upload.package.step.3', status: 'incomplete' },
                            { label: 'mautic.marketplace.upload.package.step.4', status: 'incomplete' }
                        ]
                    } %}
                </div>
                <div class="col-12 col-lg-9 border-start bg-light layer-two">
                    <div class="row">
                        <div class="col-12 col-lg-10 gap-64 p-32">
                            {% include 'marketplace/upload/package/step--upload.html.twig' %}
                        </div>
                    </div>
                    <div class="row border-top border-bottom">
                        <div class="col-12 col-md-6 col-xl g-0">
                            {% include 'components/button.html.twig' with {
                                buttons: [
                                    {
                                        label: 'Cancel',
                                        variant: 'ghost',
                                        size: '2xl',
                                        attributes: {
                                            href: path('marketplace_index'),
                                            class: 'w-100'
                                        }
                                    }
                                ]
                            } only %}
                        </div>
                        <div class="col-12 col-md-6 col-xl g-0">
                            <div class="d-flex flex-column flex-md-row">
                                {% include 'components/button.html.twig' with {
                                    buttons: [

                                        {
                                            label: 'Next',
                                            variant: 'primary',
                                            size: '2xl',
                                            attributes: {
                                                type: 'submit',
                                                class: 'col',
                                                'data-wizard-nav': 'next'
                                            }
                                        }
                                    ]
                                } only %}
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </form>

    <!-- Step 2 -->
    <form data-wizard-step="2" class="needs-validation" novalidate hidden>
        <div class="container-fluid">
            <div class="row">
                <div class="col-12 col-lg-3 p-32">
                    {% include 'components/progress-indicator.html.twig' with {
                        vertical: true,
                        steps: [
                            { label: 'mautic.marketplace.upload.package.step.1', status: 'complete' },
                            { label: 'mautic.marketplace.upload.package.step.2', status: 'current', secondaryLabel: 'Package metadata' },
                            { label: 'mautic.marketplace.upload.package.step.3', status: 'incomplete' },
                            { label: 'mautic.marketplace.upload.package.step.4', status: 'incomplete' }
                        ]
                    } %}
                </div>
                <div class="col-12 col-lg-9 border-start bg-light layer-two">
                    <div class="row">
                        <div class="col-12 col-lg-10 gap-64 p-32">
                            {% include 'marketplace/upload/package/step--basics.html.twig' %}
                        </div>
                    </div>
                    <div class="row border-top border-bottom">
                        <div class="col-12 col-md-4 col-lg-4 col-xl g-0">
                            {% include 'components/button.html.twig' with {
                                buttons: [
                                    {
                                        label: 'Cancel',
                                        variant: 'ghost',
                                        size: '2xl',
                                        attributes: {
                                            href: path('marketplace_index'),
                                            class: 'col'
                                        }
                                    }
                                ]
                            } only %}
                        </div>
                        <div class="col-12 col-md-8 col-lg-8 col-xl g-0">
                            <div class="d-flex flex-column flex-md-row">
                                {% include 'components/button.html.twig' with {
                                    buttons: [
                                        {
                                            label: 'Back',
                                            variant: 'secondary',
                                            size: '2xl',
                                            attributes: {
                                                type: 'button',
                                                class: 'col',
                                                'data-wizard-nav': 'back'
                                            }
                                        },
                                        {
                                            label: 'Next',
                                            variant: 'primary',
                                            size: '2xl',
                                            attributes: {
                                                type: 'submit',
                                                class: 'col',
                                                'data-wizard-nav': 'next'
                                            }
                                        }
                                    ]
                                } only %}
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </form>

    <!-- Step 3 -->
    <form data-wizard-step="3" class="needs-validation" novalidate hidden>
        <div class="container-fluid">
            <div class="row">
                <div class="col-12 col-lg-3 p-32">
                    {% include 'components/progress-indicator.html.twig' with {
                        vertical: true,
                        steps: [
                            { label: 'mautic.marketplace.upload.package.step.1', status: 'complete' },
                            { label: 'mautic.marketplace.upload.package.step.2', status: 'complete' },
                            { label: 'mautic.marketplace.upload.package.step.3', status: 'current', secondaryLabel: 'Content and compatibility' },
                            { label: 'mautic.marketplace.upload.package.step.4', status: 'incomplete' }
                        ]
                    } %}
                </div>
                <div class="col-12 col-lg-9 border-start bg-light layer-two">
                    <div class="row">
                        <div class="col-12 col-lg-10 gap-64 p-32">
                            {% include 'marketplace/upload/package/step--details.html.twig' %}
                        </div>
                    </div>
                    <div class="row border-top border-bottom">
                        <div class="col-12 col-md-4 col-lg-4 col-xl g-0">
                            {% include 'components/button.html.twig' with {
                                buttons: [
                                    {
                                        label: 'Cancel',
                                        variant: 'ghost',
                                        size: '2xl',
                                        attributes: {
                                            href: path('marketplace_index'),
                                            class: 'col'
                                        }
                                    }
                                ]
                            } only %}
                        </div>
                        <div class="col-12 col-md-8 col-lg-8 col-xl g-0">
                            <div class="d-flex flex-column flex-md-row">
                                {% include 'components/button.html.twig' with {
                                    buttons: [
                                        {
                                            label: 'Back to Basics',
                                            variant: 'secondary',
                                            size: '2xl',
                                            attributes: {
                                                type: 'button',
                                                class: 'col',
                                                'data-wizard-nav': 'back'
                                            }
                                        },
                                        {
                                            label: 'Next',
                                            variant: 'primary',
                                            size: '2xl',
                                            attributes: {
                                                type: 'submit',
                                                class: 'col',
                                                'data-wizard-nav': 'next'
                                            }
                                        }
                                    ]
                                } only %}
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </form>

    <!-- Step 4 -->
    <form data-wizard-step="4" class="needs-validation" novalidate hidden>
        <div class="container-fluid">
            <div class="row">
                <div class="col-12 col-lg-3 p-32">
                    {% include 'components/progress-indicator.html.twig' with {
                        vertical: true,
                        steps: [
                            { label: 'mautic.marketplace.upload.package.step.1', status: 'complete' },
                            { label: 'mautic.marketplace.upload.package.step.2', status: 'complete' },
                            { label: 'mautic.marketplace.upload.package.step.3', status: 'complete' },
                            { label: 'mautic.marketplace.upload.package.step.4', status: 'current', secondaryLabel: 'Commercial details and payout connection' }
                        ]
                    } %}
                </div>
                <div class="col-12 col-lg-9 border-start bg-light layer-two">
                    <div class="row">
                        <div class="col-12 col-lg-10 gap-64 p-32">
                            {% include 'marketplace/upload/package/step--pricing_legal.html.twig' %}
                        </div>
                    </div>
                    <div class="row border-top border-bottom">
                        <div class="col-12 col-md-4 col-lg-4 col-xl g-0">
                            {% include 'components/button.html.twig' with {
                                buttons: [
                                    {
                                        label: 'Cancel',
                                        variant: 'ghost',
                                        size: '2xl',
                                        attributes: {
                                            href: path('marketplace_index'),
                                            class: 'w-100'
                                        }
                                    }
                                ]
                            } only %}
                        </div>
                        <div class="col-12 col-md-8 col-lg-8 col-xl g-0">
                            <div class="d-flex flex-column flex-md-row">
                                {% include 'components/button.html.twig' with {
                                    buttons: [
                                        {
                                            label: 'Back',
                                            variant: 'secondary',
                                            size: '2xl',
                                            attributes: {
                                                type: 'button',
                                                class: 'col',
                                                'data-wizard-nav': 'back'
                                            }
                                        },
                                        {
                                            label: 'Submit your package',
                                            variant: 'primary',
                                            size: '2xl',
                                            attributes: {
                                                type: 'submit',
                                                class: 'col',
                                                'data-wizard-nav': 'submit'
                                            }
                                        }
                                    ]
                                } only %}
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </form>
{% endblock %}
